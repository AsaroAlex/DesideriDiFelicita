---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingCalendar from '../components/BookingCalendar.astro';
import { site } from '../data/site';

const title = 'Prenota il tuo appuntamento';
const description = `Scegli il servizio, il giorno e l’orario da ${site.businessName} a ${site.address.city}. Prenota dal calendario del salone.`;
const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Prenota', href: '/prenota' },
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <section class="section booking-page">
    <div class="container">
      <header class="section__head">
        <h1>Prenota in salone</h1>
        <p class="lead">
          Scegli il servizio, il giorno e l’orario che desideri.
        </p>
      </header>
      <BookingCalendar />
    </div>
  </section>
</BaseLayout>

<style>
  .booking-page {
    padding-top: var(--space-lg);
  }
  .section__head {
    margin-bottom: var(--space-lg);
  }
  .section__head h1 {
    font-size: var(--fs-600);
  }
  .section__head .lead {
    margin-top: var(--space-sm);
    font-size: var(--fs-200);
  }
</style>
