---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Reveal from '../components/Reveal.astro';
import { withBase } from '../lib/href';
import { site } from '../data/site';

const title = 'Servizi';
const description =
  'Taglio donna, uomo e bambino, colore, balayage, cura del riccio e trattamenti professionali nel salone Desideri di Felicità a Galliera (BO).';
const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Servizi', href: '/servizi' },
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <section class="section">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Servizi</p>
        <h1>I nostri servizi</h1>
        <p class="lead">
          Ogni trattamento nasce dall’ascolto del tuo desiderio. Dal taglio al colore,
          fino alla cura del capello riccio: ti accompagniamo verso il look che ti
          rappresenta. I prezzi si definiscono insieme in base al servizio.
        </p>
      </div>

      <div class="grid grid--3">
        {
          site.services.map((s, i) => (
            <Reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
              <ServiceCard
                headingLevel="h2"
                index={i + 1}
                name={s.name}
                description={s.description}
                priceConfirmed={site.confirmed.prices}
              />
            </Reveal>
          ))
        }
      </div>

      <div class="cta-band">
        <p>Hai scelto il servizio per il tuo prossimo look?</p>
        <a class="btn btn--primary" href={withBase('/prenota')}>Scegli giorno e orario</a>
      </div>
    </div>
  </section>
</BaseLayout>
