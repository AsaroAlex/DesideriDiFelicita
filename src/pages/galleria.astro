---
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import WhatsappButton from '../components/WhatsappButton.astro';
import { site } from '../data/site';
import { galleryImages } from '../data/images';

const title = 'Galleria';
const description =
  'I lavori del salone Desideri di Felicità: tagli, colori, balayage, capelli ricci e acconciature realizzati a Galliera (BO).';
const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Galleria', href: '/galleria' },
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <section class="section">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Galleria</p>
        <h1>I nostri lavori</h1>
        <p class="lead">
          Tagli, colori, balayage e cura del riccio. Lasciati ispirare — e seguici su
          <a class="link-underline" href={site.instagramUrl} target="_blank" rel="noopener"
            >Instagram</a
          > per i look più recenti.
        </p>
      </div>

      <Gallery images={galleryImages} placeholders={9} />

      <div class="cta-band">
        <p>Hai uno stile che ti piacerebbe realizzare?</p>
        <WhatsappButton label="Parlane con noi su WhatsApp" />
      </div>
    </div>
  </section>
</BaseLayout>
