---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Gallery from '../components/Gallery.astro';
import MapEmbed from '../components/MapEmbed.astro';
import ContactDetails from '../components/ContactDetails.astro';
import Faq from '../components/Faq.astro';
import Testimonials from '../components/Testimonials.astro';
import Reveal from '../components/Reveal.astro';
import { site } from '../data/site';
import { withBase } from '../lib/href';
import { galleryImages, teamImages } from '../data/images';

const featuredGallery = [
  galleryImages[0],
  galleryImages[1],
  galleryImages[3],
  galleryImages[5],
].filter(Boolean);
const homeServices = site.services
  .filter((service) => service.name !== 'Cura del riccio')
  .slice(0, 6);
const jessicaImage = teamImages[0];
const ricciImage = galleryImages.find((image) => image.category === 'Ricci') ?? galleryImages[1];
---

<BaseLayout faq={site.faqs}>
  <Hero />

  <!-- Galleria subito visibile -->
  <section class="section section--tight gallery-first">
    <div class="container">
      <div class="section__head section__head--split">
        <div>
          <p class="eyebrow">Galleria</p>
          <h2>Guarda i lavori, poi scegli il tuo desiderio</h2>
        </div>
        <p class="lead">
          Tagli, colori, ricci e pieghe realizzati in salone: sotto ogni foto trovi il
          tipo di trattamento.
        </p>
      </div>
      <Gallery images={featuredGallery} placeholders={6} />
      <p class="section__cta">
        <a class="btn btn--outline" href={withBase('/galleria')}>Apri tutta la galleria</a>
      </p>
    </div>
  </section>

  <!-- Jessica -->
  <section class="section section--alt">
    <div class="container about-jessica">
      <div class="about-jessica__copy stack">
        <p class="eyebrow">Jessica Asaro</p>
        <h2>Una consulenza tranquilla, prima ancora del taglio</h2>
        <p class="lead">
          Desideri di Felicità è il salone di Jessica: un luogo piccolo, curato e
          accogliente dove ogni look parte dall’ascolto.
        </p>
        <p>
          Taglio, colore, balayage e trattamenti vengono scelti insieme, guardando il
          tuo viso, la tua routine e il modo in cui vuoi sentirti quando esci dal salone.
        </p>
        <p>
          <a class="link-underline" href={withBase('/chi-siamo')}>Conosci meglio Jessica →</a>
        </p>
      </div>
      <Reveal class="about-jessica__media" data-reveal="fade">
        <Image
          src={jessicaImage.src}
          alt={jessicaImage.alt}
          class="about-jessica__img"
          widths={[420, 720, 960]}
          sizes="(min-width: 900px) 38vw, 90vw"
          loading="lazy"
        />
      </Reveal>
    </div>
  </section>

  <!-- Cura del riccio separata -->
  <section class="section ricci-focus">
    <div class="container ricci-focus__inner">
      <Reveal class="ricci-focus__media" data-reveal="fade">
        <Image
          src={ricciImage.src}
          alt={ricciImage.alt}
          class="ricci-focus__img"
          widths={[420, 720, 960]}
          sizes="(min-width: 900px) 38vw, 90vw"
          loading="lazy"
        />
      </Reveal>
      <div class="ricci-focus__copy stack">
        <p class="eyebrow">La specialità</p>
        <h2>Cura del riccio, senza forzarlo</h2>
        <p class="lead">
          Una sezione a parte perché il riccio non è un servizio qualunque: ha bisogno di
          ascolto, taglio giusto, asciugatura paziente e consigli semplici da rifare a casa.
        </p>
        <p>
          L’obiettivo è lasciare forma, volume e morbidezza naturali, senza trasformare il
          tuo capello in qualcosa che non ti somiglia.
        </p>
      </div>
    </div>
  </section>

  <!-- Servizi -->
  <section class="section section--alt">
    <div class="container">
      <div class="section__head section__head--split">
        <div>
          <p class="eyebrow">Servizi</p>
          <h2>Cura, stile e colore su misura</h2>
        </div>
        <p class="lead">
          I servizi principali, presentati in modo più leggero. Il dettaglio completo resta
          nella pagina dedicata.
        </p>
      </div>
      <div class="grid grid--3 services-preview">
        {
          homeServices.map((s, i) => (
            <Reveal style={`--reveal-delay:${(i % 3) * 70}ms`}>
              <ServiceCard
                index={i + 1}
                name={s.name}
                description={s.description}
                variant="line"
                showPrice={false}
              />
            </Reveal>
          ))
        }
      </div>
      <p class="section__cta">
        <a class="btn btn--outline" href={withBase('/servizi')}>Tutti i servizi</a>
      </p>
    </div>
  </section>

  <!-- Recensioni -->
  <section class="section testimonials-band">
    <div class="container center">
      <div class="section__head center-block">
        <p class="eyebrow">Dicono di noi</p>
        <h2>Le parole delle clienti</h2>
        <p class="lead">La soddisfazione di chi ci ha scelto, direttamente da Google.</p>
      </div>
      <Testimonials />
    </div>
  </section>

  <!-- Instagram -->
  <section class="section section--blush">
    <div class="container center stack">
      <p class="eyebrow center-block">Instagram</p>
      <h2>Seguici su Instagram</h2>
      <p class="lead center-block">
        Ogni giorno nuovi look, consigli e ispirazioni dal salone. Le prenotazioni sono
        aperte anche in DM.
      </p>
      <p class="section__cta">
        <a class="btn btn--gold" href={site.instagramUrl} target="_blank" rel="noopener">
          @desideri.di.felicita
        </a>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container container--narrow">
      <div class="section__head">
        <p class="eyebrow">Domande frequenti</p>
        <h2>Tutto quello che vuoi sapere</h2>
      </div>
      <Faq items={site.faqs} />
    </div>
  </section>

  <!-- Contatti -->
  <section class="section section--alt">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Dove siamo</p>
        <h2>Vieni a trovarci</h2>
      </div>
      <div class="grid grid--2 contact-grid">
        <ContactDetails />
        <MapEmbed />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section__cta {
    margin-top: var(--space-xl);
  }
  .section__head--split {
    display: grid;
    gap: var(--space-lg);
  }
  @media (min-width: 900px) {
    .section__head--split {
      grid-template-columns: minmax(0, 1.05fr) minmax(22rem, 0.7fr);
      align-items: start;
      max-width: none;
    }
  }
  .gallery-first {
    background:
      linear-gradient(180deg, var(--color-bg) 0%, var(--color-surface-alt) 100%);
  }
  .about-jessica,
  .ricci-focus__inner {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }
  @media (min-width: 900px) {
    .about-jessica,
    .ricci-focus__inner {
      grid-template-columns: minmax(0, 0.85fr) minmax(22rem, 0.7fr);
    }
    .ricci-focus__inner {
      grid-template-columns: minmax(22rem, 0.7fr) minmax(0, 0.85fr);
    }
  }
  .about-jessica__img,
  .ricci-focus__img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
  }
  .ricci-focus {
    background:
      linear-gradient(180deg, var(--color-bg) 0%, var(--color-blush-soft) 100%);
  }
  .services-preview {
    row-gap: var(--space-xl);
  }
  .testimonials-band {
    background: var(--color-bg);
  }
  .contact-grid {
    align-items: start;
  }
</style>
