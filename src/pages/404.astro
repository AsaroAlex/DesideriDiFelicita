---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/href';

const title = 'Pagina non trovata';
---

<BaseLayout title={title} noindex={true}>
  <section class="section">
    <div class="container container--narrow center stack">
      <p class="eyebrow">Errore 404</p>
      <h1>Questa pagina non esiste</h1>
      <p class="lead center-block">
        La pagina che cerchi potrebbe essere stata spostata o non essere più
        disponibile. Da qui puoi tornare alla home o raggiungere le sezioni principali.
      </p>
      <p>
        <a class="btn btn--primary" href={withBase('/')}>Torna alla home</a>
      </p>
      <nav class="error-links" aria-label="Sezioni principali">
        <a class="link-underline" href={withBase('/servizi')}>Servizi</a>
        <a class="link-underline" href={withBase('/galleria')}>Galleria</a>
        <a class="link-underline" href={withBase('/contatti')}>Contatti</a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .error-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-lg);
    margin-top: var(--space-sm);
  }
</style>
