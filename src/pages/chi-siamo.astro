---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsappButton from '../components/WhatsappButton.astro';
import { site } from '../data/site';

const title = 'Chi siamo';
const description =
  'La storia e la filosofia del salone Desideri di Felicità: la bellezza nasce da un desiderio.';
const c = site.confirmed;
---

<BaseLayout title={title} description={description}>
  <section class="section">
    <div class="container container--narrow stack">
      <p class="eyebrow">Chi siamo</p>
      <h1>{site.slogan}</h1>

      <p class="lead">{site.description}</p>

      <p>
        Da <strong>Desideri di Felicità</strong> crediamo che prendersi cura dei propri
        capelli sia molto più di un gesto estetico: è un momento di benessere, ascolto e
        fiducia. Ogni cliente è unica, e ogni servizio nasce dall’attenzione ai suoi
        desideri.
      </p>

      <p>
        Il salone è guidato da <strong>{site.ownerName}</strong>
        {!c.ownerName && <span class="badge-tbc">da confermare</span>}, con passione per
        l’acconciatura e cura del dettaglio.
      </p>

      <p class="note">
        Questa pagina contiene testi provvisori: la storia e i contenuti definitivi
        verranno completati insieme alla titolare.
      </p>

      <div class="about-cta">
        <WhatsappButton label="Scrivici su WhatsApp" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-cta {
    margin-top: var(--space-lg);
  }
</style>
