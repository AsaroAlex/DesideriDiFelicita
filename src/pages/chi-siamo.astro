---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsappButton from '../components/WhatsappButton.astro';
import { site } from '../data/site';

const title = 'Chi siamo';
const description =
  'La storia e la filosofia di Desideri di Felicità, il salone di Jessica Asaro a Galliera (BO): cura del riccio, ascolto e benessere.';
const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Chi siamo', href: '/chi-siamo' },
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <section class="section">
    <div class="container container--narrow stack">
      <p class="eyebrow">Chi siamo</p>
      <h1>{site.slogan}</h1>

      <p class="lead">{site.tagline}</p>

      <p>
        <strong>Desideri di Felicità</strong> è il salone di
        <strong>{site.ownerName}</strong>, hair stylist a Galliera (BO). Un luogo nato
        dal desiderio di unire competenza tecnica e accoglienza, dove ogni persona si
        sente ascoltata.
      </p>

      <p>
        Crediamo che prendersi cura dei propri capelli sia molto più di un gesto
        estetico: è un momento di benessere e fiducia. Per questo dedichiamo attenzione
        a ogni dettaglio, dalla consulenza iniziale fino al risultato finale, con una
        particolare passione per la <strong>cura del capello riccio</strong> e l’uso di
        prodotti professionali.
      </p>

      <hr class="rule-gold" />

      <p>
        Taglio, colore, balayage, trattamenti e styling per donna, uomo e bambino: ti
        aspettiamo per creare insieme il tuo momento felice.
      </p>

      <div class="about-cta">
        <WhatsappButton label="Scrivici su WhatsApp" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-cta {
    margin-top: var(--space-lg);
  }
</style>
