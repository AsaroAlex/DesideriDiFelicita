---
import { site } from '../data/site';
import { salonQuestionMessage, telHref, whatsappHref } from '../lib/contact';
import { withBase } from '../lib/href';

const message = salonQuestionMessage(site.ownerName);
const fallbackHref = whatsappHref(site.whatsapp, message);
---

<div
  class="booking"
  data-booking-calendar
  data-api-base={withBase('api/public/')}
  data-whatsapp-number={site.whatsapp.replace(/[^\d]/g, '')}
  data-business-name={site.businessName}
  data-assistance-message={message}
>
  <p class="booking__status" data-booking-status role="status" aria-live="polite">Carichiamo il calendario del salone…</p>
  <button class="btn btn--outline booking__retry" type="button" data-config-retry hidden>
    Ricarica il calendario
  </button>

  <ol class="booking__steps" data-booking-steps aria-label="I tre passaggi della prenotazione">
    <li aria-current="step"><span aria-hidden="true">1</span> Servizio</li>
    <li><span aria-hidden="true">2</span> Giorno e ora</li>
    <li><span aria-hidden="true">3</span> Recapiti</li>
  </ol>
  <form class="booking__form" data-booking-form>
    <div class="booking__recap" data-booking-recap hidden>
      <p class="booking__summary" data-selection-summary></p>
      <button class="booking__edit" type="button" data-edit-selection>Modifica</button>
    </div>
    <fieldset class="booking__panel booking__service" disabled>
      <legend><span aria-hidden="true">1.</span> Scegli il servizio</legend>
      <label class="booking__label" for="booking-service">Servizio</label>
      <select id="booking-service" name="serviceId" required data-service>
        <option value="">Scegli un servizio</option>
      </select>
      <p class="booking__help booking__service-meta" data-service-duration></p>
      <details class="booking__service-description" data-service-description-wrap hidden>
        <summary>Dettagli del servizio</summary>
        <p class="booking__help" data-service-description></p>
      </details>
    </fieldset>

    <div class="booking__availability-action" data-availability-action hidden>
      <button class="booking__find-first" type="button" data-first-slot disabled>Trova il primo orario da richiedere</button>
      <p class="booking__help" data-first-status role="status" aria-live="polite" hidden></p>
    </div>
    <div class="booking__when">
      <fieldset class="booking__panel" disabled>
        <legend><span aria-hidden="true">2.</span> Giorno e orario</legend>
        <div class="booking__month-nav">
          <button class="booking__month-button" type="button" data-month-prev aria-label="Mese precedente">
            <span aria-hidden="true">←</span>
          </button>
          <p class="booking__month" id="booking-month" data-month-title aria-live="polite">Calendario</p>
          <button class="booking__month-button" type="button" data-month-next aria-label="Mese successivo">
            <span aria-hidden="true">→</span>
          </button>
        </div>
        <div class="booking__calendar" data-calendar role="grid" aria-labelledby="booking-month" aria-busy="true"></div>
        <p class="booking__help" id="booking-calendar-help">
          Nel calendario puoi usare anche i tasti freccia. Gli orari
          compaiono dopo aver scelto un servizio e un giorno. I giorni di chiusura non sono selezionabili.
        </p>
        <details class="booking__date-alternative"><summary>Preferisci inserire la data?</summary>
        <label class="booking__label booking__date-label" for="booking-date">Data dell’appuntamento</label>
        <input id="booking-date" type="date" name="date" required data-date aria-describedby="booking-calendar-help" />
        </details>
      </fieldset>

      <fieldset class="booking__panel booking__times-panel" disabled>
        <legend><span data-time-heading>Scegli l’orario</span></legend>
        <p class="booking__help" data-slots-status role="status" aria-live="polite">
          Scegli prima un servizio e un giorno.
        </p>
        <div class="booking__slots" data-slots></div>
        <button class="booking__text-button" type="button" data-slots-retry hidden>
          Ricarica gli orari
        </button>
        <p class="booking__timezone">Gli orari sono quelli del salone, in Italia.</p>
      </fieldset>
    </div>

    <button class="btn btn--primary booking__continue" type="button" data-go-contact hidden>Continua ai recapiti</button>
    <fieldset class="booking__panel booking__details" data-details disabled hidden>
      <legend><span aria-hidden="true">3.</span> I tuoi recapiti</legend>
      <p class="booking__mode" data-booking-mode role="status" aria-live="polite" hidden></p>
      <div class="booking__contact-fields">
        <div>
          <label class="booking__label" for="booking-name">Nome e cognome</label>
          <input id="booking-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="100" required data-name />
        </div>
        <div>
          <label class="booking__label" for="booking-phone">Numero di telefono</label>
          <input id="booking-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="Es. 333 123 4567" maxlength="25" required data-phone aria-describedby="booking-phone-help" />
          <p class="booking__help" id="booking-phone-help">Per i numeri italiani non serve il +39. Per i numeri esteri aggiungi il prefisso internazionale.</p>
        </div>
      </div>
      <div class="booking__notes">
        <label class="booking__label" for="booking-notes">Vuoi aggiungere qualcosa? <span>(facoltativo)</span></label>
        <textarea id="booking-notes" name="notes" rows="3" maxlength="500" data-notes aria-describedby="booking-notes-help" placeholder="Es. Vorrei mantenere la lunghezza e valorizzare i ricci."></textarea>
        <p class="booking__help" id="booking-notes-help">Le tue indicazioni aiutano Jessica a preparare l’appuntamento. <span data-notes-count>0/500</span></p>
      </div>
      <label class="booking__consent" for="booking-reminder">
        <input id="booking-reminder" type="checkbox" name="reminderConsent" data-reminder />
        <span>Vorrei ricevere un promemoria su WhatsApp il giorno prima dell’appuntamento.</span>
      </label>
      <p class="booking__help">
        Il promemoria è facoltativo. Usiamo i tuoi recapiti per gestire
        l’appuntamento: <a href={withBase('privacy/')} target="_blank" rel="noopener">leggi l’informativa privacy</a>.
      </p>
      <button class="btn btn--primary booking__submit" type="submit" data-submit disabled>
        Invia richiesta
      </button>
    </fieldset>
    <!-- Fuori dal pannello recapiti: resta visibile anche quando gli orari vengono ricaricati. -->
    <p class="booking__submit-status" data-submit-status role="status" aria-live="polite" hidden></p>
  </form>

  <section class="booking__confirmation booking__panel" data-confirmation hidden aria-labelledby="booking-confirmation-title">
    <p class="eyebrow" data-confirmation-eyebrow>Il tuo appuntamento</p>
    <h2 id="booking-confirmation-title" tabindex="-1">Appuntamento confermato</h2>
    <p class="booking__confirmation-recap" data-confirmation-recap></p>
    <p class="booking__reference">Il tuo riferimento: <strong data-confirmation-reference></strong></p>
    <p data-confirmation-next></p>
    <div class="booking__receipt-actions" data-management-actions hidden>
      <a class="btn btn--primary" data-management-link>Gestisci il tuo appuntamento</a>
      <button class="booking__text-button" type="button" data-copy-management>Copia il collegamento privato</button>
      <button class="btn btn--outline" type="button" data-download-calendar hidden>Aggiungi al calendario</button>
      <input class="booking__copy-url" type="text" readonly data-copy-url hidden aria-label="Collegamento privato da copiare" />
      <p class="booking__help">Conserva questo collegamento: ti permette di ritrovare lo stato e gestire l’appuntamento. È personale.</p>
      <p class="booking__help" data-receipt-action-status role="status" aria-live="polite" hidden></p>
    </div>
    <a class="booking__support-link" data-change-link href={fallbackHref} target="_blank" rel="noopener">Contatta il salone</a>
  </section>

  <p class="booking__support" data-booking-support>
    Hai una domanda? <a data-fallback-link href={fallbackHref} target="_blank" rel="noopener">Scrivi al salone su WhatsApp</a>
    oppure chiama il <a href={telHref(site.phone)}>{site.phone}</a>.
  </p>
  <noscript>
    <p class="booking__status">Per usare il calendario attiva JavaScript nel browser. Puoi anche chiamare il salone al <a href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}>{site.phone}</a>.</p>
  </noscript>
</div>

<script>
  interface BookingService {
    id: string;
    name: string;
    durationMinutes: number | null;
    instantBooking: boolean;
    description: string;
    priceCents: number | null;
    priceFrom: boolean;
  }

  interface BookingConfig {
    bookingEnabled: boolean;
    today: string;
    bookingDays: number;
    services: BookingService[];
    requestEnabled: boolean;
    closedDates: string[];
    openingHours: { day: string; ranges: { opens: string; closes: string }[] }[];
  }

  interface Slot {
    time: string;
    label: string;
    startsAt: number;
    endsAt: number | null;
  }

  interface BookingConfirmation {
    reference: string;
    status: string;
    serviceName: string;
    date: string;
    time: string;
    durationMinutes?: number;
    managementPath?: string | null;
  }

  class BookingApiError extends Error {
    status: number;
    code: string;
    /** Messaggio in italiano già pensato per le clienti, inviato dal server. */
    serverMessage: string;
    constructor(status: number, code = '', serverMessage = '') {
      super(code || 'booking_request_failed');
      this.status = status;
      this.code = code;
      this.serverMessage = typeof serverMessage === 'string' ? serverMessage.slice(0, 300) : '';
    }
  }

  function newRequestId(): string {
    if (typeof crypto.randomUUID === 'function') return crypto.randomUUID();
    // Safari < 15.4: stessa forma di UUID v4 con crypto.getRandomValues.
    const bytes = crypto.getRandomValues(new Uint8Array(16));
    bytes[6] = (bytes[6] & 0x0f) | 0x40;
    bytes[8] = (bytes[8] & 0x3f) | 0x80;
    const hex = Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('');
    return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
  }

  const monthFormatter = new Intl.DateTimeFormat('it-IT', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  const dayFormatter = new Intl.DateTimeFormat('it-IT', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
  const priceFormatter = new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR' });
  const shortDayFormatter = new Intl.DateTimeFormat('it-IT', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' });
  const datePattern = /^\d{4}-\d{2}-\d{2}$/;
  const timePattern = /^(?:[01]\d|2[0-3]):[0-5]\d$/;

  // The API supplies calendar days in Europe/Rome. UTC is used only to do
  // arithmetic on those day labels, never to convert a client's local time.
  function dayValue(value: string): Date {
    return new Date(`${value}T12:00:00Z`);
  }

  function isoDay(value: Date): string {
    return value.toISOString().slice(0, 10);
  }

  function shiftDay(value: string, offset: number): string {
    const day = dayValue(value);
    day.setUTCDate(day.getUTCDate() + offset);
    return isoDay(day);
  }

  function shiftMonth(value: string, offset: number): string {
    const day = dayValue(`${value.slice(0, 7)}-01`);
    day.setUTCMonth(day.getUTCMonth() + offset);
    return isoDay(day);
  }

  function validDay(value: unknown): value is string {
    return typeof value === 'string' && datePattern.test(value)
      && !Number.isNaN(dayValue(value).getTime()) && isoDay(dayValue(value)) === value;
  }

  function readConfig(value: unknown): BookingConfig {
    const input = value as BookingConfig & { requestServices?: BookingService[] };
    if (!input || typeof input.bookingEnabled !== 'boolean' || !validDay(input.today)
      || !Number.isInteger(input.bookingDays) || input.bookingDays < 1 || input.bookingDays > 366
      || !Array.isArray(input.services)) {
      throw new BookingApiError(502);
    }
    const requestEnabled = input.requestEnabled === true;
    const catalog = new Map<string, BookingService>();
    if (requestEnabled && Array.isArray(input.requestServices)) {
      input.requestServices.forEach((item) => {
        if (!item || typeof item.id !== 'string' || typeof item.name !== 'string') return;
        const duration = Number.isInteger(item.durationMinutes) && Number(item.durationMinutes) >= 5
          && Number(item.durationMinutes) <= 480 ? item.durationMinutes : null;
        catalog.set(item.id, { id: item.id, name: item.name, durationMinutes: duration,
          description: typeof item.description === 'string' ? item.description : '',
          priceCents: Number.isSafeInteger(item.priceCents) && Number(item.priceCents) >= 0 && Number(item.priceCents) <= 1_000_000 ? item.priceCents : null,
          priceFrom: item.priceFrom === true,
          instantBooking: input.bookingEnabled && item.instantBooking === true && duration !== null });
      });
    }
    if (input.bookingEnabled) {
      input.services.forEach((item) => {
        if (!item || typeof item.id !== 'string' || typeof item.name !== 'string'
          || !Number.isInteger(item.durationMinutes) || Number(item.durationMinutes) < 5 || Number(item.durationMinutes) > 480) return;
        catalog.set(item.id, { ...item, description: typeof item.description === 'string' ? item.description : '',
          priceCents: Number.isSafeInteger(item.priceCents) && Number(item.priceCents) >= 0 && Number(item.priceCents) <= 1_000_000 ? item.priceCents : null,
          priceFrom: item.priceFrom === true, instantBooking: true });
      });
    }
    return { ...input, requestEnabled, services: [...catalog.values()],
      closedDates: Array.isArray(input.closedDates) ? input.closedDates.filter(validDay) : [],
      openingHours: Array.isArray(input.openingHours) ? input.openingHours : [] };
  }

  function normalizeClientPhone(value: string): string {
    const cleaned = value.trim().replace(/[\s().\/-]/g, '');
    if (cleaned.startsWith('00')) return `+${cleaned.slice(2)}`;
    // Numeri italiani scritti senza prefisso: cellulare (3…) o fisso (0…).
    if (/^(?:3\d{8,9}|0\d{5,10})$/.test(cleaned)) return `+39${cleaned}`;
    if (/^39(?:3\d{8,9}|0\d{5,10})$/.test(cleaned)) return `+${cleaned}`;
    return cleaned;
  }

  let disposeCurrent: (() => void) | undefined;

  function initializeBooking() {
    const root = document.querySelector<HTMLElement>('[data-booking-calendar]');
    if (!root || root.dataset.bookingReady === 'true') return;
    disposeCurrent?.();
    root.dataset.bookingReady = 'true';

    const form = root.querySelector<HTMLFormElement>('[data-booking-form]')!;
    const status = root.querySelector<HTMLElement>('[data-booking-status]')!;
    const configRetry = root.querySelector<HTMLButtonElement>('[data-config-retry]')!;
    const serviceSelect = root.querySelector<HTMLSelectElement>('[data-service]')!;
    const serviceDuration = root.querySelector<HTMLElement>('[data-service-duration]')!;
    const serviceDescriptionWrap = root.querySelector<HTMLDetailsElement>('[data-service-description-wrap]')!;
    const serviceDescription = root.querySelector<HTMLElement>('[data-service-description]')!;
    const firstSlotButton = root.querySelector<HTMLButtonElement>('[data-first-slot]')!;
    const availabilityAction = root.querySelector<HTMLElement>('[data-availability-action]')!;
    const firstStatus = root.querySelector<HTMLElement>('[data-first-status]')!;
    const recap = root.querySelector<HTMLElement>('[data-booking-recap]')!;
    const stepItems = Array.from(root.querySelectorAll<HTMLElement>('[data-booking-steps] li'));
    const editSelection = root.querySelector<HTMLButtonElement>('[data-edit-selection]')!;
    const continueButton = root.querySelector<HTMLButtonElement>('[data-go-contact]')!;
    const contactPanel = root.querySelector<HTMLFieldSetElement>('[data-details]')!;
    const notesInput = root.querySelector<HTMLTextAreaElement>('[data-notes]')!;
    const modeStatus = root.querySelector<HTMLElement>('[data-booking-mode]')!;
    const timeHeading = root.querySelector<HTMLElement>('[data-time-heading]')!;
    const dateInput = root.querySelector<HTMLInputElement>('[data-date]')!;
    const calendar = root.querySelector<HTMLElement>('[data-calendar]')!;
    const monthTitle = root.querySelector<HTMLElement>('[data-month-title]')!;
    const monthPrev = root.querySelector<HTMLButtonElement>('[data-month-prev]')!;
    const monthNext = root.querySelector<HTMLButtonElement>('[data-month-next]')!;
    const slotsContainer = root.querySelector<HTMLElement>('[data-slots]')!;
    const slotsStatus = root.querySelector<HTMLElement>('[data-slots-status]')!;
    const slotsRetry = root.querySelector<HTMLButtonElement>('[data-slots-retry]')!;
    const selectionSummary = root.querySelector<HTMLElement>('[data-selection-summary]')!;
    const nameInput = root.querySelector<HTMLInputElement>('[data-name]')!;
    const phoneInput = root.querySelector<HTMLInputElement>('[data-phone]')!;
    const reminderInput = root.querySelector<HTMLInputElement>('[data-reminder]')!;
    const submit = root.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitStatus = root.querySelector<HTMLElement>('[data-submit-status]')!;
    const confirmation = root.querySelector<HTMLElement>('[data-confirmation]')!;
    const fallbackLink = root.querySelector<HTMLAnchorElement>('[data-fallback-link]')!;
    const changeLink = root.querySelector<HTMLAnchorElement>('[data-change-link]')!;
    const support = root.querySelector<HTMLElement>('[data-booking-support]')!;
    const managementActions = root.querySelector<HTMLElement>('[data-management-actions]')!;
    const managementLink = root.querySelector<HTMLAnchorElement>('[data-management-link]')!;
    const copyManagement = root.querySelector<HTMLButtonElement>('[data-copy-management]')!;
    const calendarDownload = root.querySelector<HTMLButtonElement>('[data-download-calendar]')!;
    const copyUrl = root.querySelector<HTMLInputElement>('[data-copy-url]')!;
    const receiptStatus = root.querySelector<HTMLElement>('[data-receipt-action-status]')!;
    const lifecycle = new AbortController();
    let configRequest: AbortController | undefined;
    let availabilityRequest: AbortController | undefined;
    let bookingRequest: AbortController | undefined;
    let firstRequest: AbortController | undefined;
    let receiptRequest: AbortController | undefined;
    let config: BookingConfig | undefined;
    let maxDate = '';
    let displayedMonth = '';
    let selectedDate = '';
    let focusedDate = '';
    let selectedTime = '';
    let slots: Slot[] = [];
    let submitting = false;
    let requestPayloadKey = '';
    let requestId = '';
    let received = false;
    let uncertainSubmission = false;
    let uncertainBody = '';
    let uncertainRequested = true;
    let firstSearching = false;
    let contactStarted = false;
    let receiptToken = '';
    let prefillHandled = false;
    const objectUrls = new Set<string>();

    disposeCurrent = () => {
      lifecycle.abort();
      configRequest?.abort();
      availabilityRequest?.abort();
      bookingRequest?.abort();
      firstRequest?.abort();
      receiptRequest?.abort();
      objectUrls.forEach((url) => URL.revokeObjectURL(url));
      objectUrls.clear();
      receiptToken = '';
    };

    const on = (target: EventTarget, event: string, listener: EventListener) => {
      target.addEventListener(event, listener, { signal: lifecycle.signal });
    };

    const latestMessage = new WeakMap<HTMLElement, string>();
    const showMessage = (target: HTMLElement, message: string) => {
      latestMessage.set(target, message);
      if (!message || !target.hidden) {
        target.textContent = message;
        target.hidden = !message;
        return;
      }
      // A live region that appears together with its text is often not read
      // aloud: show the empty region first, then write the latest message.
      target.textContent = '';
      target.hidden = false;
      requestAnimationFrame(() => {
        const latest = latestMessage.get(target);
        if (latest && !target.hidden && target.textContent !== latest) target.textContent = latest;
      });
    };

    function service(): BookingService | undefined {
      return config?.services.find((item) => item.id === serviceSelect.value);
    }

    function makeWhatsappLink(message: string): string {
      return `https://wa.me/${root!.dataset.whatsappNumber}?text=${encodeURIComponent(message)}`;
    }

    function requestMode(): boolean {
      return !service()?.instantBooking;
    }

    function dateIsOpen(date: string): boolean {
      if (!config || config.closedDates.includes(date)) return false;
      if (config.openingHours.length !== 7) return true;
      const names = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
      return Boolean(config.openingHours.find((day) => day.day === names[dayValue(date).getUTCDay()])?.ranges.length);
    }

    function updateSelection() {
      const chosenService = service();
      const requested = requestMode();
      const ready = Boolean(chosenService && selectedDate && selectedTime);
      submit.disabled = !ready || submitting || received;
      submit.textContent = submitting ? (requested ? 'Invio in corso…' : 'Conferma in corso…')
        : uncertainSubmission ? 'Riprova l’invio' : requested ? 'Invia richiesta' : 'Conferma appuntamento';
      availabilityAction.hidden = !chosenService;
      firstSlotButton.disabled = !chosenService || submitting || firstSearching || received || uncertainSubmission;
      firstSlotButton.textContent = firstSearching ? 'Cerchiamo il primo orario…'
        : requested ? 'Trova il primo orario da richiedere' : 'Trova la prima disponibilità';
      timeHeading.textContent = requested ? 'Orario desiderato' : 'Scegli l’orario';
      modeStatus.hidden = !chosenService;
      modeStatus.textContent = requested
        ? 'Jessica verifica la disponibilità e ti contatta per confermare l’appuntamento.'
        : 'Per questo servizio puoi confermare direttamente il tuo appuntamento sul sito.';
      const meta: string[] = [];
      if (chosenService?.durationMinutes) meta.push(`${chosenService.durationMinutes} minuti`);
      if (chosenService) meta.push(chosenService.priceCents === null ? 'Prezzo su richiesta'
        : `${chosenService.priceFrom ? 'Da ' : ''}${priceFormatter.format(chosenService.priceCents / 100)}`);
      if (chosenService) meta.push(requested ? 'Jessica ti conferma l’orario' : 'Conferma immediata');
      serviceDuration.textContent = meta.join(' · ');
      serviceDescription.textContent = chosenService?.description || '';
      serviceDescriptionWrap.hidden = !chosenService?.description;
      recap.hidden = !chosenService;
      const summary = chosenService ? [chosenService.name] : [];
      if (selectedDate) summary.push(shortDayFormatter.format(dayValue(selectedDate)));
      if (selectedTime) summary.push(selectedTime);
      if (ready) summary.push(requested ? 'Da confermare' : 'Conferma sul sito');
      selectionSummary.textContent = summary.join(' · ');
      continueButton.hidden = !ready || contactStarted || uncertainSubmission;
      continueButton.disabled = submitting;
      contactPanel.hidden = !ready || !contactStarted;
      const currentStep = !chosenService ? 0 : !ready || !contactStarted ? 1 : 2;
      stepItems.forEach((item, index) => {
        if (index === currentStep) item.setAttribute('aria-current', 'step');
        else item.removeAttribute('aria-current');
        item.classList.toggle('is-complete', index < currentStep);
      });
      let message = chosenService ? `Ciao Jessica, vorrei un consiglio sul servizio ${chosenService.name}.` : root!.dataset.assistanceMessage!;
      if (selectedDate && selectedTime) message += ` Mi interesserebbe ${dayFormatter.format(dayValue(selectedDate))} alle ${selectedTime}.`;
      fallbackLink.href = makeWhatsappLink(message);
      if (uncertainSubmission) {
        form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | HTMLButtonElement>('input,select,textarea,button').forEach((field) => { if (field !== submit) field.disabled = true; });
      }
    }

    function clearSlots() {
      selectedTime = '';
      contactStarted = false;
      slots = [];
      slotsContainer.replaceChildren();
      slotsRetry.hidden = true;
      updateSelection();
    }

    async function requestJson(path: string, request: RequestInit, controller: AbortController): Promise<{ value: unknown; status: number }> {
      const timedRequest = new AbortController();
      const cancel = () => timedRequest.abort();
      controller.signal.addEventListener('abort', cancel, { once: true });
      const timeout = window.setTimeout(cancel, 20_000);
      try {
        const response = await fetch(`${root!.dataset.apiBase}${path}`, {
          credentials: 'same-origin',
          cache: 'no-store',
          ...request,
          signal: timedRequest.signal,
          headers: { Accept: 'application/json', ...request.headers },
        });
        if (!response.headers.get('content-type')?.includes('application/json')) {
          throw new BookingApiError(response.status || 502);
        }
        const value = await response.json();
        if (!response.ok) throw new BookingApiError(response.status, value?.error?.code, value?.error?.message);
        return { value, status: response.status };
      } finally {
        window.clearTimeout(timeout);
        controller.signal.removeEventListener('abort', cancel);
      }
    }

    function renderCalendar(focus = false) {
      if (!config) return;
      monthTitle.textContent = monthFormatter.format(dayValue(displayedMonth));
      monthPrev.disabled = displayedMonth.slice(0, 7) <= config.today.slice(0, 7);
      monthNext.disabled = displayedMonth.slice(0, 7) >= maxDate.slice(0, 7);
      calendar.replaceChildren();
      const weekdayRow = document.createElement('div');
      weekdayRow.className = 'booking-calendar-row booking-calendar-weekdays';
      weekdayRow.setAttribute('role', 'row');
      ['Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab', 'Dom'].forEach((label) => {
        const cell = document.createElement('span');
        cell.setAttribute('role', 'columnheader');
        cell.textContent = label;
        weekdayRow.append(cell);
      });
      calendar.append(weekdayRow);
      const firstDay = `${displayedMonth.slice(0, 7)}-01`;
      const offset = (dayValue(firstDay).getUTCDay() + 6) % 7;
      const firstCell = shiftDay(firstDay, -offset);
      const nextMonth = shiftMonth(firstDay, 1);
      const daysInMonth = dayValue(shiftDay(nextMonth, -1)).getUTCDate();
      const cells = Math.ceil((offset + daysInMonth) / 7) * 7;
      const firstAllowed = firstDay < config.today ? config.today : firstDay;
      let focusDay = focusedDate.slice(0, 7) === displayedMonth.slice(0, 7) && dateIsOpen(focusedDate) ? focusedDate : firstAllowed;
      while (focusDay < nextMonth && focusDay <= maxDate && !dateIsOpen(focusDay)) focusDay = shiftDay(focusDay, 1);
      let row: HTMLDivElement | undefined;
      for (let index = 0; index < cells; index++) {
        if (index % 7 === 0) {
          row = document.createElement('div');
          row.className = 'booking-calendar-row';
          row.setAttribute('role', 'row');
          calendar.append(row);
        }
        const date = shiftDay(firstCell, index);
        const cell = document.createElement('div');
        cell.setAttribute('role', 'gridcell');
        if (date.slice(0, 7) !== displayedMonth.slice(0, 7)) {
          cell.className = 'booking-calendar-empty';
          cell.setAttribute('aria-hidden', 'true');
        } else {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'booking-day';
          button.dataset.day = date;
          button.textContent = String(dayValue(date).getUTCDate());
          button.setAttribute('aria-label', `${dayFormatter.format(dayValue(date))}${dateIsOpen(date) ? '' : ', salone chiuso'}`);
          button.setAttribute('aria-pressed', String(date === selectedDate));
          const unavailable = date < config.today || date > maxDate || !dateIsOpen(date);
          button.classList.toggle('is-unavailable', unavailable);
          button.disabled = unavailable || submitting;
          button.tabIndex = !button.disabled && date === focusDay ? 0 : -1;
          if (date === config.today) button.setAttribute('aria-current', 'date');
          cell.append(button);
        }
        row!.append(cell);
      }
      calendar.removeAttribute('aria-busy');
      if (focus) calendar.querySelector<HTMLButtonElement>('[tabindex="0"]')?.focus();
    }

    function renderSlots(values: Slot[], requested: boolean) {
      slotsContainer.replaceChildren();
      slots = values.filter((slot) => slot && timePattern.test(slot.time)
        && typeof slot.label === 'string' && Number.isFinite(slot.startsAt)
        && (requested ? slot.endsAt === null : Number.isFinite(slot.endsAt)));
      if (!slots.length) {
        slotsStatus.textContent = requested
          ? 'Non ci sono orari da richiedere in questo giorno. Scegli un’altra data.'
          : 'Non ci sono appuntamenti disponibili per questo servizio in questo giorno. Scegli un’altra data.';
        return;
      }
      slotsStatus.textContent = requested
        ? 'Scegli l’orario che preferisci. La richiesta sarà verificata dal salone.'
        : `Orari disponibili per ${dayFormatter.format(dayValue(selectedDate))}.`;
      slots.forEach((slot) => {
        const label = document.createElement('label');
        label.className = 'booking-slot';
        const input = document.createElement('input');
        input.type = 'radio';
        input.name = 'time';
        input.value = slot.time;
        input.required = true;
        const text = document.createElement('span');
        text.textContent = slot.label;
        label.append(input, text);
        slotsContainer.append(label);
      });
    }

    async function loadSlots() {
      firstRequest?.abort();
      firstSearching = false;
      availabilityRequest?.abort();
      clearSlots();
      const chosenService = service();
      if (!chosenService || !selectedDate) {
        slotsStatus.textContent = 'Scegli prima un servizio e un giorno.';
        return;
      }
      const controller = new AbortController();
      availabilityRequest = controller;
      slotsContainer.setAttribute('aria-busy', 'true');
      const requested = !chosenService.instantBooking;
      slotsStatus.textContent = requested ? 'Carichiamo gli orari che puoi richiedere…' : 'Cerchiamo gli orari disponibili…';
      const query = new URLSearchParams({ serviceId: chosenService.id, date: selectedDate });
      try {
        const { value } = await requestJson(`${requested ? 'request-availability' : 'availability'}?${query}`, {}, controller);
        if (controller.signal.aborted || lifecycle.signal.aborted) return;
        const result = value as { mode?: string; date: string; serviceId: string; slots: Slot[] };
        if (result.date !== selectedDate || result.serviceId !== chosenService.id || !Array.isArray(result.slots)
          || (requested && result.mode !== 'request')) {
          throw new BookingApiError(502);
        }
        renderSlots(result.slots, requested);
      } catch (error) {
        if (controller.signal.aborted || lifecycle.signal.aborted) return;
        if (error instanceof BookingApiError && ['request_disabled', 'booking_disabled'].includes(error.code)) {
          void loadConfig();
          return;
        }
        slotsStatus.textContent = error instanceof BookingApiError && error.status === 429
          ? 'Aspetta un momento prima di cercare altri orari, poi riprova.'
          : 'Non riusciamo a caricare gli orari di questo giorno. Premi Ricarica gli orari per riprovare.';
        slotsRetry.hidden = false;
      } finally {
        if (availabilityRequest === controller) slotsContainer.removeAttribute('aria-busy');
      }
    }

    async function findFirstSlot() {
      const chosenService = service();
      if (!config || !chosenService || firstSearching || submitting || received || uncertainSubmission) return;
      firstRequest?.abort();
      availabilityRequest?.abort();
      clearSlots();
      firstSearching = true;
      updateSelection();
      showMessage(firstStatus, '');
      const controller = new AbortController();
      firstRequest = controller;
      const requested = !chosenService.instantBooking;
      const query = new URLSearchParams({ serviceId: chosenService.id, from: config.today, days: '14' });
      try {
        const { value } = await requestJson(`availability-range?${query}`, {}, controller);
        if (controller.signal.aborted || lifecycle.signal.aborted || service()?.id !== chosenService.id) return;
        const range = value as { serviceId: string; mode: string; days: { date: string; slots: Slot[] }[] };
        if (range.serviceId !== chosenService.id || range.mode !== (requested ? 'request' : 'instant') || !Array.isArray(range.days)) throw new BookingApiError(502);
        const day = [...range.days].filter((item) => validDay(item.date) && item.date >= config!.today && item.date <= maxDate && dateIsOpen(item.date) && Array.isArray(item.slots) && item.slots.length)
          .sort((a, b) => a.date.localeCompare(b.date))[0];
        if (!day) {
          showMessage(firstStatus, requested ? 'Nei prossimi 14 giorni non ci sono orari da richiedere. Puoi cercare una data successiva nel calendario.'
            : 'Nei prossimi 14 giorni non ci sono appuntamenti disponibili. Puoi cercare una data successiva nel calendario.');
          return;
        }
        selectedDate = day.date;
        focusedDate = day.date;
        displayedMonth = `${day.date.slice(0, 7)}-01`;
        dateInput.value = day.date;
        dateInput.setCustomValidity('');
        renderCalendar();
        renderSlots(day.slots, requested);
        if (!slots.length) throw new BookingApiError(502);
        const first = [...slots].sort((a, b) => a.startsAt - b.startsAt)[0];
        selectedTime = first.time;
        const radio = Array.from(slotsContainer.querySelectorAll<HTMLInputElement>('input')).find((input) => input.value === first.time);
        if (radio) radio.checked = true;
        showMessage(firstStatus, requested ? 'Abbiamo selezionato il primo orario che puoi richiedere. Jessica ne verificherà la disponibilità.'
          : 'Abbiamo selezionato il primo appuntamento disponibile. Controlla il riepilogo e completa i recapiti.');
        updateSelection();
      } catch (error) {
        if (controller.signal.aborted || lifecycle.signal.aborted) return;
        showMessage(firstStatus, 'Non siamo riusciti a cercare il primo orario. Puoi riprovare oppure scegliere un giorno dal calendario.');
      } finally {
        if (firstRequest === controller && !lifecycle.signal.aborted) {
          firstSearching = false;
          updateSelection();
        }
      }
    }

    function chooseDate(value: string, focus = false) {
      if (!config || !validDay(value) || value < config.today || value > maxDate || !dateIsOpen(value) || submitting || uncertainSubmission) return;
      selectedDate = value;
      focusedDate = value;
      displayedMonth = `${value.slice(0, 7)}-01`;
      dateInput.value = value;
      dateInput.setCustomValidity('');
      showMessage(submitStatus, '');
      renderCalendar(focus);
      void loadSlots();
    }

    async function loadConfig() {
      configRequest?.abort();
      availabilityRequest?.abort();
      firstRequest?.abort();
      firstSearching = false;
      configRetry.hidden = true;
      const controller = new AbortController();
      configRequest = controller;
      showMessage(status, 'Carichiamo il calendario del salone…');
      form.querySelectorAll<HTMLFieldSetElement>('fieldset').forEach((field) => { field.disabled = true; });
      try {
        const { value } = await requestJson('config', {}, controller);
        if (controller.signal.aborted || lifecycle.signal.aborted) return;
        config = readConfig(value);
        maxDate = shiftDay(config.today, config.bookingDays);
        displayedMonth = `${config.today.slice(0, 7)}-01`;
        selectedDate = '';
        focusedDate = config.today;
        dateInput.min = config.today;
        dateInput.max = maxDate;
        serviceSelect.replaceChildren(new Option('Scegli un servizio', ''));
        config.services.forEach((item) => serviceSelect.add(new Option(item.name, item.id)));
        renderCalendar();
        if (!config.services.length) {
          showMessage(status, 'Le prenotazioni dal calendario sono momentaneamente sospese. Per informazioni puoi contattare il salone.');
          modeStatus.hidden = true;
          return;
        }
        form.querySelectorAll<HTMLFieldSetElement>('fieldset').forEach((field) => { field.disabled = false; });
        showMessage(status, '');
        clearSlots();
        slotsStatus.textContent = 'Scegli prima un servizio e un giorno.';
        if (!prefillHandled) {
          prefillHandled = true;
          const preference = new URLSearchParams(location.search).get('servizio')?.trim();
          const match = preference && config.services.find((item) => item.id === preference || item.name.toLocaleLowerCase('it-IT') === preference.toLocaleLowerCase('it-IT'));
          if (match) serviceSelect.value = match.id;
        }
        updateSelection();
      } catch {
        if (controller.signal.aborted || lifecycle.signal.aborted) return;
        showMessage(status, 'Il calendario non si è caricato. Premi Ricarica il calendario oppure contatta il salone su WhatsApp o al telefono: trovi i contatti qui sotto.');
        configRetry.hidden = false;
      }
    }

    on(firstSlotButton, 'click', () => { void findFirstSlot(); });
    on(editSelection, 'click', () => { serviceSelect.focus(); serviceSelect.scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); });
    on(continueButton, 'click', () => { contactStarted = true; updateSelection(); nameInput.focus({ preventScroll: true }); contactPanel.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); });
    on(notesInput, 'input', () => { root!.querySelector<HTMLElement>('[data-notes-count]')!.textContent = `${notesInput.value.length}/500`; });
    on(configRetry, 'click', () => { void loadConfig(); });
    on(serviceSelect, 'change', () => {
      if (uncertainSubmission) return;
      showMessage(submitStatus, '');
      showMessage(firstStatus, '');
      serviceDescriptionWrap.open = false;
      void loadSlots();
    });
    on(dateInput, 'change', () => {
      if (!config || uncertainSubmission) return;
      if (!validDay(dateInput.value) || dateInput.value < config.today || dateInput.value > maxDate || !dateIsOpen(dateInput.value)) {
        dateInput.setCustomValidity('Scegli una data di apertura nel periodo disponibile.');
        selectedDate = '';
        availabilityRequest?.abort();
        clearSlots();
        slotsStatus.textContent = 'Scegli una data nel periodo disponibile.';
        renderCalendar();
        return;
      }
      chooseDate(dateInput.value);
    });
    on(monthPrev, 'click', () => {
      if (!monthPrev.disabled) {
        displayedMonth = shiftMonth(displayedMonth, -1);
        renderCalendar();
      }
    });
    on(monthNext, 'click', () => {
      if (!monthNext.disabled) {
        displayedMonth = shiftMonth(displayedMonth, 1);
        renderCalendar();
      }
    });
    on(calendar, 'click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-day]');
      if (!button || button.disabled) return;
      chooseDate(button.dataset.day!, true);
      // On a phone the times are below the calendar: bring them into view after a tap
      // (detail > 0 means a pointer, so keyboard users keep their place in the grid).
      const timesPanel = root!.querySelector<HTMLElement>('.booking__times-panel');
      if ((event as MouseEvent).detail > 0 && timesPanel && matchMedia('(max-width: 839px)').matches && timesPanel.getBoundingClientRect().top > window.innerHeight * 0.6) {
        timesPanel.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }
    });
    on(calendar, 'keydown', (event) => {
      const keyboard = event as KeyboardEvent;
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-day]');
      if (!button || button.disabled || !config || uncertainSubmission) return;
      let day = button.dataset.day!;
      const weekday = (dayValue(day).getUTCDay() + 6) % 7;
      switch (keyboard.key) {
        case 'ArrowLeft': day = shiftDay(day, -1); break;
        case 'ArrowRight': day = shiftDay(day, 1); break;
        case 'ArrowUp': day = shiftDay(day, -7); break;
        case 'ArrowDown': day = shiftDay(day, 7); break;
        case 'Home': {
          const weekEnd = shiftDay(day, 6 - weekday);
          day = shiftDay(day, -weekday);
          if (day < config.today) day = config.today;
          while (day <= weekEnd && !dateIsOpen(day)) day = shiftDay(day, 1);
          if (day > weekEnd) return;
          break;
        }
        case 'End': {
          const weekStart = shiftDay(day, -weekday);
          day = shiftDay(day, 6 - weekday);
          if (day > maxDate) day = maxDate;
          while (day >= weekStart && !dateIsOpen(day)) day = shiftDay(day, -1);
          if (day < weekStart || day < config.today) return;
          break;
        }
        case 'PageUp': day = shiftMonth(day, -1); break;
        case 'PageDown': day = shiftMonth(day, 1); break;
        default: return;
      }
      keyboard.preventDefault();
      const direction = ['ArrowLeft', 'ArrowUp', 'Home', 'PageUp'].includes(keyboard.key) ? -1 : 1;
      day = day < config.today ? config.today : day > maxDate ? maxDate : day;
      for (let tries = 0; tries < 7 && !dateIsOpen(day); tries++) {
        const next = shiftDay(day, direction);
        if (next < config.today || next > maxDate) break;
        day = next;
      }
      focusedDate = day;
      displayedMonth = `${focusedDate.slice(0, 7)}-01`;
      renderCalendar(true);
    });
    on(slotsContainer, 'change', (event) => {
      const input = event.target as HTMLInputElement;
      if (uncertainSubmission || input.name !== 'time' || !slots.some((slot) => slot.time === input.value)) return;
      selectedTime = input.value;
      showMessage(submitStatus, '');
      updateSelection();
    });
    on(slotsRetry, 'click', () => { void loadSlots(); });
    on(nameInput, 'input', () => nameInput.setCustomValidity(''));
    on(phoneInput, 'input', () => phoneInput.setCustomValidity(''));

    function setReceiptActions(booking: BookingConfirmation) {
      receiptToken = '';
      managementActions.hidden = true;
      calendarDownload.hidden = true;
      copyUrl.hidden = true;
      if (typeof booking.managementPath !== 'string') return;
      try {
        const url = new URL(booking.managementPath, location.origin);
        const expectedPath = withBaseCustomerPath();
        const token = new URLSearchParams(url.hash.slice(1)).get('chiave') || '';
        if (url.origin !== location.origin || url.search || url.pathname.replace(/\/+$/, '') !== expectedPath || !/^[A-Za-z0-9_-]{43}$/.test(token)) return;
        receiptToken = token;
        managementLink.href = url.href;
        managementLink.textContent = booking.status === 'pending' || booking.status === 'declined' || booking.status === 'withdrawn' ? 'Gestisci la tua richiesta' : 'Gestisci il tuo appuntamento';
        copyUrl.value = url.href;
        managementActions.hidden = false;
        calendarDownload.hidden = booking.status !== 'confirmed';
      } catch { /* Keep the ordinary assistance link when private access is absent. */ }
    }

    function withBaseCustomerPath(): string {
      const publicApiPath = new URL(root!.dataset.apiBase!, location.origin).pathname;
      return `${publicApiPath.replace(/api\/public\/?$/, '')}appuntamento`.replace(/\/+$/, '');
    }

    on(copyManagement, 'click', async () => {
      if (!receiptToken) return;
      try {
        await navigator.clipboard.writeText(copyUrl.value);
        if (!lifecycle.signal.aborted) showMessage(receiptStatus, 'Collegamento copiato. Conservalo in un posto sicuro.');
      } catch {
        if (lifecycle.signal.aborted) return;
        copyUrl.hidden = false;
        copyUrl.focus();
        copyUrl.select();
        showMessage(receiptStatus, 'Seleziona e copia il collegamento qui sopra.');
      }
    });

    on(calendarDownload, 'click', async () => {
      if (!receiptToken || receiptRequest) return;
      const controller = new AbortController();
      receiptRequest = controller;
      calendarDownload.disabled = true;
      showMessage(receiptStatus, 'Prepariamo il file per il tuo calendario…');
      const timeout = setTimeout(() => controller.abort(), 20_000);
      try {
        const response = await fetch(`${root!.dataset.apiBase}customer/calendar.ics`, { headers: { Authorization: `Bearer ${receiptToken}`, Accept: 'text/calendar' }, credentials: 'omit', cache: 'no-store', signal: controller.signal });
        if (!response.ok || !response.headers.get('content-type')?.includes('text/calendar')) throw new Error('calendar_unavailable');
        const blob = await response.blob();
        if (lifecycle.signal.aborted) return;
        const url = URL.createObjectURL(blob);
        objectUrls.add(url);
        const link = document.createElement('a');
        link.href = url;
        link.download = 'desideri-appuntamento.ics';
        document.body.append(link);
        link.click();
        link.remove();
        setTimeout(() => { URL.revokeObjectURL(url); objectUrls.delete(url); }, 1_000);
        showMessage(receiptStatus, 'File pronto. Puoi aprirlo nel calendario del tuo telefono.');
      } catch {
        if (!lifecycle.signal.aborted) showMessage(receiptStatus, 'Il file non è disponibile. Apri Gestisci il tuo appuntamento per controllare lo stato aggiornato.');
      } finally {
        clearTimeout(timeout);
        if (receiptRequest === controller) receiptRequest = undefined;
        if (!lifecycle.signal.aborted) calendarDownload.disabled = false;
      }
    });

    on(form, 'submit', async (event) => {
      event.preventDefault();
      if (submitting || received || !service() || !selectedDate || !selectedTime) return;
      const retryingUncertain = uncertainSubmission;
      let requested = requestMode();
      let postBody = uncertainBody;
      if (retryingUncertain) {
        requested = uncertainRequested;
      } else {
        const name = nameInput.value.trim();
        const phone = normalizeClientPhone(phoneInput.value);
        if (name.length < 2) nameInput.setCustomValidity('Inserisci il tuo nome e cognome.');
        if (!/^\+[1-9]\d{7,14}$/.test(phone)) phoneInput.setCustomValidity('Controlla il numero di telefono. Per i numeri esteri aggiungi il prefisso internazionale, per esempio +40.');
        if (!form.reportValidity()) return;
        const payload = { serviceId: serviceSelect.value, date: selectedDate, time: selectedTime, name, phone, reminderConsent: reminderInput.checked, notes: notesInput.value.trim() };
        const payloadKey = JSON.stringify(payload);
        if (requestPayloadKey !== payloadKey) { requestPayloadKey = payloadKey; requestId = newRequestId(); }
        postBody = JSON.stringify({ ...payload, clientRequestId: requestId });
        uncertainBody = postBody;
        uncertainRequested = requested;
      }
      submitting = true;
      updateSelection();
      form.setAttribute('aria-busy', 'true');
      const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | HTMLButtonElement>('input, select, textarea, button'));
      const originallyDisabled = fields.map((field) => field.disabled);
      fields.forEach((field) => { field.disabled = true; });
      showMessage(submitStatus, requested ? 'Stiamo inviando la tua richiesta…' : 'Stiamo confermando il tuo appuntamento…');
      const controller = new AbortController();
      bookingRequest = controller;
      try {
        const result = await requestJson(requested ? 'requests' : 'bookings', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: postBody,
        }, controller);
        if (controller.signal.aborted || lifecycle.signal.aborted) return;
        const booking = result.value as BookingConfirmation;
        const allowedStatus = requested ? ['pending', 'confirmed', 'declined', 'cancelled', 'withdrawn'] : ['confirmed', 'cancelled'];
        if (result.status !== 201 || !allowedStatus.includes(booking.status) || typeof booking.reference !== 'string'
          || !booking.reference || typeof booking.serviceName !== 'string' || !validDay(booking.date) || !timePattern.test(booking.time)) {
          throw new BookingApiError(502);
        }
        const pending = booking.status === 'pending';
        const declined = booking.status === 'declined';
        const cancelled = booking.status === 'cancelled';
        const withdrawn = booking.status === 'withdrawn';
        received = true;
        uncertainSubmission = false;
        uncertainBody = '';
        root!.querySelector<HTMLElement>('[data-booking-steps]')!.hidden = true;
        form.hidden = true;
        showMessage(status, '');
        root!.querySelector<HTMLElement>('[data-confirmation-eyebrow]')!.textContent = pending ? 'Un passo verso il tuo nuovo look' : declined || cancelled || withdrawn ? 'Aggiornamento dal salone' : 'Ci vediamo in salone';
        root!.querySelector<HTMLElement>('#booking-confirmation-title')!.textContent = pending ? 'Richiesta ricevuta' : declined ? 'Richiesta non confermata' : withdrawn ? 'Richiesta ritirata' : cancelled ? 'Appuntamento annullato' : 'Appuntamento confermato';
        root!.querySelector<HTMLElement>('[data-confirmation-recap]')!.textContent = `${booking.serviceName} · ${dayFormatter.format(dayValue(booking.date))} alle ${booking.time}${pending ? ' · orario da confermare' : ''}.`;
        root!.querySelector<HTMLElement>('[data-confirmation-reference]')!.textContent = booking.reference;
        root!.querySelector<HTMLElement>('[data-confirmation-next]')!.textContent = pending
          ? 'Jessica ti contatterà per confermare l’orario. Conserva il riferimento: ti servirà se vorrai modificare la richiesta.'
          : declined ? 'Il salone non ha potuto confermare questa richiesta. Contattaci per trovare insieme un altro appuntamento.'
          : withdrawn ? 'Questa richiesta è stata ritirata. Puoi scegliere un nuovo giorno e orario dal calendario del salone.'
          : cancelled ? 'Questo appuntamento risulta annullato. Contattaci per scegliere insieme un nuovo giorno e orario.'
          : 'Il tuo appuntamento è in agenda. Per modificarlo o annullarlo, contatta il salone indicando il riferimento.';
        changeLink.href = makeWhatsappLink(`Buongiorno Jessica, ti scrivo per ${pending || declined || withdrawn ? 'la mia richiesta' : 'il mio appuntamento'} ${booking.reference}: ${booking.serviceName}, ${dayFormatter.format(dayValue(booking.date))} alle ${booking.time}. Avrei bisogno di un’informazione.`);
        setReceiptActions(booking);
        if (!managementActions.hidden && booking.status === 'confirmed') {
          root!.querySelector<HTMLElement>('[data-confirmation-next]')!.textContent = 'Il tuo appuntamento è in agenda. Dal collegamento personale puoi controllare lo stato e le opzioni per gestirlo.';
        }
        nameInput.value = '';
        phoneInput.value = '';
        reminderInput.checked = false;
        notesInput.value = '';
        root!.querySelector<HTMLElement>('[data-notes-count]')!.textContent = '0/500';
        support.hidden = true;
        confirmation.hidden = false;
        root!.querySelector<HTMLElement>('#booking-confirmation-title')!.focus();
      } catch (error) {
        if (controller.signal.aborted || lifecycle.signal.aborted) return;
        // A definitive answer (4xx other than 429) ends the uncertain state:
        // the salon has answered, so the form must become usable again.
        const definitive = error instanceof BookingApiError && error.status >= 400 && error.status < 500 && error.status !== 429;
        if (retryingUncertain && definitive) { uncertainSubmission = false; uncertainBody = ''; }
        const showSubmitError = (text: string) => {
          showMessage(submitStatus, text);
          requestAnimationFrame(() => submitStatus.scrollIntoView({ block: 'center', behavior: 'auto' }));
        };
        if (retryingUncertain && !definitive) {
          uncertainSubmission = true;
          showMessage(submitStatus, error instanceof BookingApiError && error.status === 429
            ? 'Aspetta qualche minuto, poi riprova lo stesso invio per verificare l’esito.'
            : 'Non abbiamo ancora ricevuto l’esito. Puoi riprovare lo stesso invio oppure chiedere una verifica al salone.');
        } else if (error instanceof BookingApiError && ['request_disabled', 'booking_disabled', 'date_out_of_range'].includes(error.code)) {
          showSubmitError(error.code === 'date_out_of_range'
            ? 'Il calendario è stato aggiornato alla data di oggi: scegli di nuovo il giorno e l’orario.'
            : 'Le prenotazioni sono cambiate. Aggiorniamo il calendario per mostrarti le opzioni attuali.');
          void loadConfig();
        } else if (error instanceof BookingApiError && error.status === 409) {
          showSubmitError(requested
            ? 'Questo orario non può più essere richiesto. Abbiamo aggiornato gli orari: scegli un’altra preferenza, i tuoi recapiti restano compilati.'
            : 'Questo orario è stato appena prenotato. Abbiamo aggiornato le disponibilità: scegli un altro orario, i tuoi recapiti restano compilati.');
          void loadSlots();
        } else if (error instanceof BookingApiError && error.code === 'booking_limit') {
          showSubmitError('Hai già tre appuntamenti o richieste in programma. Per prenotarne altri contatta direttamente il salone su WhatsApp o al telefono.');
        } else if (error instanceof BookingApiError && error.status === 429) {
          showSubmitError('Hai inviato diverse richieste in poco tempo. Aspetta qualche minuto, poi riprova.');
        } else if (error instanceof BookingApiError && error.status >= 400 && error.status < 500) {
          showSubmitError(error.serverMessage || 'Non abbiamo potuto registrare i dati. Controlla i recapiti e l’orario scelto, poi riprova.');
          if (!requested) void loadSlots();
        } else {
          uncertainSubmission = true;
          showMessage(submitStatus, 'Non abbiamo ricevuto la risposta. Conserviamo le tue scelte su questa pagina: riprova lo stesso invio per ricevere l’esito senza duplicati.');
        }
      } finally {
        if (!lifecycle.signal.aborted) {
          submitting = false;
          form.removeAttribute('aria-busy');
          // Leaving the uncertain state re-enables the fields it had locked.
          const unlocked = retryingUncertain && !uncertainSubmission;
          fields.forEach((field, index) => { field.disabled = unlocked ? false : originallyDisabled[index]; });
          updateSelection();
          renderCalendar();
        }
      }
    });

    void loadConfig();
  }

  document.addEventListener('astro:before-swap', () => {
    disposeCurrent?.();
    disposeCurrent = undefined;
  });
  document.addEventListener('astro:page-load', initializeBooking);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeBooking, { once: true });
  } else {
    initializeBooking();
  }
</script>

