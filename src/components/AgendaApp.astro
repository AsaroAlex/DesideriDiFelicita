    function closeEditor(force = false) {
      const close = () => { el('[data-editor]').hidden = true; el('[data-editor-guard]').hidden = true; pendingEditorTransition = null; editingId = ''; appointmentForm.reset(); editorBaseline = ''; editorOpener?.focus({ preventScroll: true }); };
      if (force) close(); else if (!busy) editorTransition(close);
    }

    function showPanel(panel: string, moveFocus = true) {
      activePanel = panel;
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach(item => { item.hidden = item.dataset.panel !== panel; });
      root.querySelectorAll<HTMLElement>('[data-tab]').forEach(button => { const selected = button.dataset.tab === panel; button.setAttribute('aria-pressed', String(selected)); button.classList.toggle('secondary', !selected); });
      document.dispatchEvent(new CustomEvent('agenda:panel', { detail: { panel } }));
      if (moveFocus) focus(`#${panel}-title`);
      if (panel === 'requests') void refreshIncomingRequests();
      if (panel === 'reminders' && session.authenticated) void act(null, async () => { await loadReminders(); inform('Elenco dei promemoria aggiornato.'); });
    }

    function renderOverview() {
      if (!settings) return;
      const listed = services.filter(service => service.listed !== false);
      const durations = listed.filter(service => service.durationMinutes).length;
      const automaticReady = listed.some(service => service.enabled && service.durationMinutes);
      const whatsappActive = Boolean(automation?.configured && automation?.enabled !== false && automation?.webhookConfigured !== false);
      const items = [
        { title: 'Calendario delle clienti', copy: settings.requestEnabled ? 'Le richieste arrivano nella tua agenda.' : 'Le richieste dal sito sono sospese.', ready: settings.requestEnabled, panel: 'settings' },
        { title: 'Servizi e durate', copy: `${listed.length} servizi visibili · ${durations} con durata impostata.`, ready: listed.length > 0 && durations === listed.length, panel: 'services' },
        { title: 'Orari del salone', copy: settings.openingHours.some(day => day.ranges.length) ? 'Controlla gli orari e aggiungi le chiusure straordinarie.' : 'Imposta i giorni e gli orari di apertura.', ready: settings.openingHours.some(day => day.ranges.length), panel: 'settings' },
        { title: 'Conferma automatica', copy: settings.bookingEnabled && automaticReady ? 'Attiva per i servizi abilitati, negli orari liberi.' : 'Decidi tu quando attivarla. Puoi già confermare le richieste a mano.', ready: settings.bookingEnabled && automaticReady, panel: 'settings' },
        { title: 'Promemoria WhatsApp', copy: whatsappActive ? (automation?.dailyLimit === 0 || automation?.monthlyLimit === 0 ? 'Collegato. Gli invii sono sospesi dai limiti impostati.' : 'Invii abilitati, secondo consenso e limiti. Verifica l’approvazione del modello su Meta.') : 'Completa il collegamento per abilitare gli invii automatici.', ready: whatsappActive && (automation?.dailyLimit || 0) > 0 && (automation?.monthlyLimit || 0) > 0, panel: 'connection' },
      ];
      el('[data-checklist]').replaceChildren(...items.map(item => {
        const li = textNode('li', '', 'checklist-item');
        const heading = textNode('div', '', 'appointment-top'); heading.append(textNode('strong', item.title), textNode('span', item.ready ? 'Pronto' : 'Da configurare', `status-badge${item.ready ? ' is-ready' : ''}`));
        const button = textNode('button', 'Apri', 'agenda-button secondary') as HTMLButtonElement; button.type = 'button'; button.setAttribute('aria-label', `Configura ${item.title.toLowerCase()}`); on(button, 'click', () => showPanel(item.panel));
        li.append(heading, textNode('p', item.copy, 'agenda-note'), button); return li;
      }));
    }

    function serviceCreationSignature() {
      return JSON.stringify(Array.from(createServiceForm.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[name], textarea[name]')).map(field => [field.name, field instanceof HTMLInputElement && field.type === 'checkbox' ? field.checked : field.value]));
    }

    function resetServiceCreation() {
      createServiceForm.reset(); serviceVariantOrigin = null; pendingServiceCreateTransition = null;
      el('[data-service-create-title]').textContent = 'Aggiungi un servizio'; el('[data-service-create-save]').textContent = 'Aggiungi servizio';
      el('[data-service-variant-close]').hidden = true; el('[data-service-variant-origin]').hidden = true; el('[data-service-variant-origin]').textContent = ''; el('[data-service-create-guard]').hidden = true;
      serviceCreateBaseline = serviceCreationSignature();
    }

    function serviceCreationTransition(task: () => void) {
      if (busy) return;
      if (serviceCreationSignature() !== serviceCreateBaseline) {
        pendingServiceCreateTransition = task; el('[data-service-create-guard]').hidden = false;
        createServiceForm.scrollIntoView({ behavior: 'auto', block: 'start' }); focus('[data-service-create-keep]'); return;
      }
      pendingServiceCreateTransition = null; el('[data-service-create-guard]').hidden = true; task();
