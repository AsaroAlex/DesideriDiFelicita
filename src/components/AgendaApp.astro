---
import { site } from '../data/site';
import WhatsAppSettings from './WhatsAppSettings.astro';
import CustomerDirectory from './CustomerDirectory.astro';
---

<script is:inline data-astro-rerun>
  // Il link di prima attivazione non rimane nella cronologia né nei link successivi.
  {
    const url = new URL(window.location.href);
    const fragment = new URLSearchParams(url.hash.slice(1));
    const token = fragment.get('attiva') || url.searchParams.get('attiva');
    if (token) {
      window.__agendaActivationToken = token;
    }
    if (url.searchParams.has('attiva') || fragment.has('attiva')) {
      url.searchParams.delete('attiva');
      if (fragment.has('attiva')) {
        fragment.delete('attiva');
        url.hash = fragment.toString();
      }
      window.history.replaceState(window.history.state, '', url.pathname + url.search + url.hash);
    }
  }
</script>

<section class="agenda section" data-agenda data-business={site.businessName} data-owner-email={site.email}>
  <div class="container">
    <header class="agenda-heading">
      <div><p class="eyebrow">Il tuo salone, organizzato</p><h1>Benvenuta, Jessica</h1><p class="lead">Gestisci le clienti e configura il salone da qui.</p></div>
      <div data-owner-controls hidden><span data-owner-email-label></span><button type="button" class="agenda-button secondary" data-logout>Esci</button></div>
    </header>
    <p class="agenda-notice" role="status" aria-live="polite" data-notice>Caricamento dell’area privata…</p>
    <noscript><p class="agenda-notice">Per accedere all’agenda occorre attivare JavaScript nel browser.</p></noscript>

    <section class="agenda-card auth-card" data-auth hidden aria-labelledby="access-title">
      <h2 id="access-title" data-auth-title>Accedi alla tua agenda</h2>
      <p data-auth-intro>Un accesso privato, riservato a Jessica.</p>
      <form data-login-form hidden>
        <label>Email<input type="email" name="email" autocomplete="username" value={site.email} required /></label>
        <label>Password<input type="password" name="password" autocomplete="current-password" required /></label>
        <button class="agenda-button" type="submit">Accedi</button>
      </form>
      <form data-setup-form hidden>
        <label>Email per l’accesso<input type="email" name="email" autocomplete="username" value={site.email} required /></label>
        <label>Scegli una password<input type="password" name="password" autocomplete="new-password" minlength="12" required aria-describedby="setup-password-help" /></label>
        <small id="setup-password-help">Almeno 12 caratteri. Scegli una password che non utilizzi altrove.</small>
        <label>Ripeti la password<input type="password" name="confirmation" autocomplete="new-password" minlength="12" required /></label>
        <button class="agenda-button" type="submit">Attiva la tua agenda</button>
      </form>
    </section>

    <div data-workspace hidden>
      <nav class="agenda-tabs" aria-label="Sezioni dell’agenda">
        <button type="button" class="agenda-button" data-tab="overview" aria-pressed="true">Panoramica</button>
        <button type="button" class="agenda-button secondary" data-tab="calendar" aria-pressed="false">Appuntamenti</button>
        <button type="button" class="agenda-button secondary" data-tab="requests" aria-pressed="false">Richieste <span class="request-count" data-request-count aria-label="Richieste da confermare">0</span></button>
        <button type="button" class="agenda-button secondary" data-tab="services" aria-pressed="false">Servizi</button>
        <button type="button" class="agenda-button secondary" data-tab="customers" aria-pressed="false">Clienti</button>
        <button type="button" class="agenda-button secondary" data-tab="settings" aria-pressed="false">Orari e impostazioni</button>
        <button type="button" class="agenda-button secondary" data-tab="connection" aria-pressed="false">Collega WhatsApp</button>
        <button type="button" class="agenda-button secondary" data-tab="reminders" aria-pressed="false">Promemoria</button>
        <button type="button" class="agenda-button secondary" data-tab="account" aria-pressed="false">Accesso e backup</button>
      </nav>

      <section data-panel="overview" aria-labelledby="overview-title">
        <div class="agenda-section-head"><h2 id="overview-title" tabindex="-1">Il salone, oggi</h2><div class="button-group"><button class="agenda-button" type="button" data-open-panel="requests">Controlla le richieste</button><button class="agenda-button secondary" type="button" data-open-calendar>Inserisci un appuntamento</button></div></div>
        <section class="agenda-stats" aria-label="Riepilogo dell’agenda" data-stats></section>
        <div class="overview-grid">
          <section class="agenda-card"><h3>Configura il tuo salone</h3><p class="agenda-note">Le richieste delle clienti sono già disponibili. Scegli tu se confermarle dopo aver controllato l’agenda oppure attivare la conferma automatica per i servizi con durata impostata.</p><ul class="setup-checklist" data-checklist></ul></section>
          <section class="agenda-card"><h3>Come lavorare ogni giorno</h3><ol class="daily-guide"><li>Apri <strong>Richieste</strong>, controlla la durata e conferma l’orario.</li><li>Aggiungi in <strong>Appuntamenti</strong> anche le prenotazioni ricevute per telefono o in salone.</li><li>Usa <strong>Clienti</strong> per ritrovare rapidamente contatti e appuntamenti.</li><li>Collega WhatsApp e imposta orario e limiti dei promemoria quando sei pronta.</li></ol></section>
        </div>
      </section>

      <section data-panel="calendar" hidden aria-labelledby="calendar-title">
        <div class="agenda-section-head"><h2 id="calendar-title" tabindex="-1">I tuoi appuntamenti</h2><button type="button" class="agenda-button" data-new>Nuovo appuntamento</button></div>
        <div class="agenda-card calendar-toolbar">
          <div class="button-group"><button type="button" class="agenda-button secondary" data-date-prev aria-label="Periodo precedente">←</button><button type="button" class="agenda-button secondary" data-today>Oggi</button><button type="button" class="agenda-button secondary" data-date-next aria-label="Periodo successivo">→</button></div>
          <label>Data<input type="date" data-calendar-date required /></label>
          <div class="button-group" aria-label="Vista calendario"><button type="button" class="agenda-button" data-view="day" aria-pressed="true">Giorno</button><button type="button" class="agenda-button secondary" data-view="week" aria-pressed="false">Settimana</button></div>
          <button type="button" class="agenda-button secondary" data-refresh>Aggiorna</button>
        </div>
        <p class="agenda-note">Gli orari sono quelli del salone, in Italia. Gli appuntamenti annullati restano visibili nello storico.</p>
        <div class="calendar-days" data-calendar aria-live="polite"></div>

        <section class="agenda-card appointment-editor" data-editor hidden aria-labelledby="editor-title">
          <div class="agenda-section-head"><h2 id="editor-title" tabindex="-1">Nuovo appuntamento</h2><button type="button" class="agenda-button secondary" data-editor-close>Chiudi</button></div>
          <form data-appointment-form>
            <div class="form-grid">
              <label>Servizio<select name="serviceId" data-appointment-services><option value="">Altro appuntamento</option></select></label>
              <label>Descrizione<input name="title" maxlength="100" placeholder="Per esempio: consulenza" required /></label>
              <label>Giorno<input type="date" name="date" required /></label>
              <label>Ora<input type="time" name="time" required /></label>
              <label>Durata, in minuti<input type="number" name="durationMinutes" min="5" max="480" step="1" required /></label>
              <label>Nome della cliente<input name="name" autocomplete="name" minlength="2" maxlength="100" required /></label>
              <label>Telefono con prefisso internazionale<input type="tel" name="phone" autocomplete="tel" placeholder="+39…" required /></label>
              <label data-status-field hidden>Stato<select name="status"><option value="confirmed">Confermato</option><option value="cancelled">Annullato</option></select></label>
            </div>
            <label class="checkbox-label"><input type="checkbox" name="reminderConsent" />La cliente ha accettato il promemoria su WhatsApp.</label>
            <p class="agenda-note">Indica la durata effettiva per occupare il tempo corretto. Il promemoria viene pianificato per la sera prima: gli appuntamenti inseriti dopo quell’orario non generano un invio tardivo.</p>
            <div class="button-group"><button type="submit" class="agenda-button">Salva appuntamento</button><button type="button" class="agenda-button secondary" data-editor-close>Lascia senza salvare</button></div>
          </form>
        </section>
      </section>

      <section data-panel="requests" hidden aria-labelledby="requests-title">
        <div class="agenda-section-head"><h2 id="requests-title" tabindex="-1">Richieste delle clienti</h2><button type="button" class="agenda-button secondary" data-requests-refresh>Aggiorna richieste</button></div>
        <p class="agenda-note">Le clienti scelgono un servizio e un orario desiderato. Controlla la durata e conferma: solo allora l’appuntamento occupa l’agenda. Le richieste non inviano messaggi automatici.</p>
        <div class="agenda-card request-toolbar"><label>Mostra<select data-request-status><option value="pending">Da confermare</option><option value="confirmed">Confermate</option><option value="declined">Non accettate</option></select></label></div>
        <div class="agenda-card request-result" data-request-result hidden aria-live="polite"></div>
        <div class="request-list" data-requests aria-live="polite"></div>
      </section>

      <section data-panel="services" hidden aria-labelledby="services-title">
        <h2 id="services-title" tabindex="-1">I servizi del salone</h2>
        <p class="agenda-note">Scegli quali servizi mostrare nel calendario, imposta i nomi e le durate reali. Nascondere un servizio conserva gli appuntamenti e le richieste già ricevute.</p>
        <form class="agenda-card service-create-form" data-service-create>
          <h3>Aggiungi un servizio</h3><div class="form-grid"><label>Nome<input name="name" maxlength="100" minlength="2" required placeholder="Nome del servizio" /></label><label>Durata, in minuti<input name="durationMinutes" type="number" min="5" max="480" step="1" placeholder="Puoi impostarla in seguito" /></label></div>
          <label class="checkbox-label"><input name="listed" type="checkbox" checked />Mostra il servizio nel calendario delle clienti</label>
          <label class="checkbox-label"><input name="enabled" type="checkbox" />Abilita la conferma automatica per questo servizio</label>
          <button class="agenda-button" type="submit">Aggiungi servizio</button>
        </form>
        <div class="service-settings" data-services></div>
      </section>

      <section data-panel="customers" hidden aria-labelledby="customers-title"><h2 id="customers-title" tabindex="-1">Le tue clienti</h2><CustomerDirectory /></section>
      <section data-panel="connection" hidden aria-labelledby="connection-title"><h2 id="connection-title" tabindex="-1">Collegamento WhatsApp</h2><WhatsAppSettings /></section>

      <section data-panel="settings" hidden aria-labelledby="settings-title">
        <h2 id="settings-title" tabindex="-1">Impostazioni del salone</h2>
        <form class="agenda-card" data-settings-form>
          <h3>Prenotazioni online</h3>
          <label class="checkbox-label"><input type="checkbox" name="requestEnabled" />Ricevi richieste dal calendario.</label>
          <p class="agenda-note">Le richieste arrivano nella sezione Richieste: scegli tu quali confermare, con la durata effettiva del servizio.</p>
          <label class="checkbox-label"><input type="checkbox" name="bookingEnabled" />Conferma automaticamente i servizi configurati.</label>
          <p class="agenda-note" data-booking-help>Per la conferma automatica servono almeno un servizio abilitato e la sua durata.</p>
          <label>Giorni prenotabili in anticipo<input type="number" name="bookingDays" min="1" max="365" required /></label>
          <h3>Orari di disponibilità</h3>
          <p class="agenda-note">Indica quando il salone è aperto. Puoi aggiungere più fasce nello stesso giorno, per esempio mattina e pomeriggio.</p>
          <div class="hours-grid" data-hours></div>
          <h3>Chiusure straordinarie</h3><div class="closure-add"><label>Giorno di chiusura<input type="date" data-closure-date /></label><button type="button" class="agenda-button secondary" data-closure-add>Aggiungi giorno</button></div>
          <ul class="closed-date-list" data-closed-dates></ul>
          <small>Le chiusure impediscono nuove prenotazioni e richieste. Non annullano gli appuntamenti già confermati.</small>
          <h3>Promemoria del giorno prima</h3>
          <label class="checkbox-label"><input type="checkbox" name="economyMode" />Modalità risparmio: massimo 10 invii al giorno e 60 al mese</label>
          <p class="agenda-note">La modalità risparmio mantiene i limiti che hai scelto e applica il valore più basso. Un limite a 0 sospende gli invii.</p>
          <div class="form-grid">
            <label>Ora di invio<input type="time" name="reminderTime" required /></label>
            <label>Limite impostato al giorno<input type="number" name="dailyReminderLimit" min="0" max="1000" required /></label>
            <label>Limite impostato al mese<input type="number" name="monthlyReminderLimit" min="0" max="10000" required /></label>
          </div>
          <p class="agenda-note" data-effective-limits></p>
          <p class="agenda-note">I limiti contengono i tentativi automatici, compresi quelli con esito incerto. Il costo dei messaggi dipende da Meta: questi numeri non sono una fattura. Dopo un invio già effettuato o incerto, un cambio di orario non genera un secondo promemoria automatico.</p>
          <button type="submit" class="agenda-button">Salva impostazioni</button>
        </form>
      </section>

      <section data-panel="account" hidden aria-labelledby="account-title">
        <h2 id="account-title" tabindex="-1">Accesso e backup</h2>
        <section class="agenda-card security-card" aria-labelledby="email-title"><h3 id="email-title">Email per l’accesso</h3><form data-account-form><label>Email<input type="email" name="email" autocomplete="username" required /></label><label>Password attuale<input type="password" name="currentPassword" autocomplete="current-password" required /></label><button class="agenda-button secondary" type="submit">Aggiorna email</button></form><p class="agenda-note">La nuova email verrà usata per accedere. Gli altri accessi verranno chiusi.</p></section>
        <section class="agenda-card security-card" aria-labelledby="security-title">
          <h3 id="security-title">Il tuo accesso</h3>
          <form data-password-form>
            <label>Password attuale<input type="password" name="currentPassword" autocomplete="current-password" required /></label>
            <label>Nuova password<input type="password" name="password" autocomplete="new-password" minlength="12" required /></label>
            <label>Ripeti la nuova password<input type="password" name="confirmation" autocomplete="new-password" minlength="12" required /></label>
            <button type="submit" class="agenda-button secondary">Cambia password</button>
          </form>
          <p class="agenda-note">Almeno 12 caratteri. Gli altri accessi verranno chiusi.</p>
        </section>
        <section class="agenda-card security-card" aria-labelledby="export-title"><h3 id="export-title">Esporta gli appuntamenti</h3><p class="agenda-note">Scegli il periodo da esportare, fino a un anno. Il file CSV si apre con Excel e contiene anche gli appuntamenti annullati.</p><form data-export-form><div class="form-grid"><label>Dal<input type="date" name="from" required /></label><label>Al<input type="date" name="to" required /></label></div><button class="agenda-button secondary" type="submit">Scarica appuntamenti in CSV</button></form></section>
        <section class="agenda-card security-card" aria-labelledby="backup-title"><h3 id="backup-title">Backup completo</h3><p class="agenda-note">Il backup conserva appuntamenti, richieste, impostazioni e collegamento WhatsApp ed è destinato al ripristino tecnico: tienilo in un posto sicuro.</p><form data-backup-form><label>Password attuale<input type="password" name="currentPassword" autocomplete="current-password" required /></label><button class="agenda-button secondary" type="submit">Scarica backup completo</button></form></section>
      </section>

      <section data-panel="reminders" hidden aria-labelledby="reminders-title">
        <h2 id="reminders-title" tabindex="-1">Promemoria WhatsApp</h2>
        <div class="agenda-card" data-automation></div>
        <p class="agenda-note">“Apri WhatsApp” prepara un messaggio manuale: controllalo e premi Invia nell’app. Non parte alcun messaggio automatico da quel pulsante.</p>
        <div class="agenda-card reminder-toolbar"><label>Promemoria previsti<select data-reminder-period><option value="today">Oggi</option><option value="tomorrow">Domani</option><option value="all">Tutti</option></select></label><button type="button" class="agenda-button secondary" data-reminders-refresh>Aggiorna elenco</button></div>
        <p class="agenda-note" data-reminder-summary></p>
        <div class="reminder-list" data-reminders></div>
      </section>
    </div>
  </div>
</section>

<script>
  import { whatsappHref } from '../lib/contact';

  type Appointment = { id: string; reference: string; serviceId?: string | null; title: string; name: string; phone: string; date: string; time: string; durationMinutes: number; status: string; reminderConsent: boolean };
  type BookingRequest = { id: string; reference: string; serviceId: string; serviceName: string; name: string; phone: string; date: string; time: string; reminderConsent: boolean; status: 'pending' | 'confirmed' | 'declined'; appointmentId?: string | null; createdAt: number; appointment?: Pick<Appointment, 'id' | 'date' | 'time' | 'durationMinutes' | 'status' | 'title'> | null };
  type Service = { id: string; name: string; durationMinutes: number | null; enabled: boolean; listed: boolean };
  type OpeningHour = { day: string; label: string; ranges: { opens: string; closes: string }[] };
  type Settings = { requestEnabled: boolean; bookingEnabled: boolean; bookingDays: number; reminderTime: string; openingHours: OpeningHour[]; closedDates: string[]; economyMode: boolean; dailyReminderLimit: number; monthlyReminderLimit: number };
  type Reminder = { id: string; appointmentId: string; name: string; phone: string; date: string; time: string; status: string; dueAt: number; attemptCount: number; errorCode?: string; errorText?: string; manualSentAt?: number | null; providerMessageId?: string | null; staleRevision?: boolean };
  type Session = { authenticated: boolean; setupRequired?: boolean; email?: string; csrfToken?: string; whatsappConfigured?: boolean };
  type Automation = { configured: boolean; enabled?: boolean; webhookConfigured?: boolean; missing: string[]; economyMode: boolean; dailyLimit: number; monthlyLimit: number; configuredDailyLimit: number; configuredMonthlyLimit: number; sentThisMonth: number; remainingToday: number; remainingThisMonth: number };
  type ServiceDraft = { name: string; duration: string; listed: boolean; enabled: boolean };
  const reminderLabels: Record<string, string> = { pending: 'In attesa', sending: 'Invio in corso', accepted: 'Accettato da WhatsApp', delivered: 'Consegnato', read: 'Letto', failed: 'Invio non riuscito', skipped: 'Non inviato', needs_review: 'Da controllare' };
  let activeRoot: HTMLElement | null = null;
  let dispose: (() => void) | undefined;

  function initAgenda() {
    const root = document.querySelector<HTMLElement>('[data-agenda]');
    if (!root || root === activeRoot) return;
    dispose?.();
    activeRoot = root;
    const lifetime = new AbortController();
    const activationWindow = window as Window & { __agendaActivationToken?: string };
    let activationToken = activationWindow.__agendaActivationToken || '';
    delete activationWindow.__agendaActivationToken;
    let csrfToken = '';
    let session: Session = { authenticated: false };
    let services: Service[] = [];
    let appointments: Appointment[] = [];
    let requests: BookingRequest[] = [];
    let requestStatus = 'pending';
    let reminders: Reminder[] = [];
    let reminderPeriod = 'today';
    let settings: Settings | undefined;
    let automation: Automation | undefined;
    let closedDatesDraft: string[] = [];
    let activePanel = 'overview';
    let settingsDirty = false;
    const serviceDrafts = new Map<string, ServiceDraft>();
    let editingId = '';
    let editorOpener: HTMLElement | null = null;
    let view = 'day';
    let selectedDate = today();
    let busy = false;
    let backgroundRefreshing = false;

    const el = <T extends HTMLElement = HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const notice = el('[data-notice]');
    const loginForm = el<HTMLFormElement>('[data-login-form]');
    const setupForm = el<HTMLFormElement>('[data-setup-form]');
    const appointmentForm = el<HTMLFormElement>('[data-appointment-form]');
    const settingsForm = el<HTMLFormElement>('[data-settings-form]');
    const passwordForm = el<HTMLFormElement>('[data-password-form]');
    const accountForm = el<HTMLFormElement>('[data-account-form]');
    const backupForm = el<HTMLFormElement>('[data-backup-form]');
    const exportForm = el<HTMLFormElement>('[data-export-form]');
    const createServiceForm = el<HTMLFormElement>('[data-service-create]');
    const input = <T extends HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement = HTMLInputElement>(form: HTMLFormElement, name: string) => form.elements.namedItem(name) as T;
    const on = (target: EventTarget, event: string, handler: EventListener) => target.addEventListener(event, handler, { signal: lifetime.signal });
    const textNode = (tag: string, text: string, className = '') => { const node = document.createElement(tag); node.textContent = text; if (className) node.className = className; return node; };
    const inform = (message: string, error = false) => { notice.textContent = message; notice.classList.toggle('is-error', error); notice.setAttribute('role', error ? 'alert' : 'status'); };
    const focus = (selector: string) => el(selector)?.focus({ preventScroll: true });

    function today() { return new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Rome', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date()); }
    function addDays(date: string, count: number) { const parsed = new Date(date + 'T12:00:00Z'); parsed.setUTCDate(parsed.getUTCDate() + count); return parsed.toISOString().slice(0, 10); }
    function prettyDate(date: string, weekday = true) { return new Intl.DateTimeFormat('it-IT', { timeZone: 'UTC', ...(weekday ? { weekday: 'long' as const } : {}), day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(date + 'T12:00:00Z')); }
    function weekStart(date: string) { const day = new Date(date + 'T12:00:00Z').getUTCDay(); return addDays(date, -((day + 6) % 7)); }
    function period() { const from = view === 'week' ? weekStart(selectedDate) : selectedDate; return { from, to: view === 'week' ? addDays(from, 6) : from }; }

    async function api<T>(path: string, method = 'GET', body?: unknown): Promise<T> {
      const requestSession = session;
      const response = await fetch(path, { method, credentials: 'same-origin', signal: lifetime.signal, headers: { Accept: 'application/json', ...(body !== undefined ? { 'Content-Type': 'application/json' } : {}), ...(method !== 'GET' && csrfToken ? { 'x-csrf-token': csrfToken } : {}) }, ...(body !== undefined ? { body: JSON.stringify(body) } : {}) });
      const data = await response.json().catch(() => null);
      // Una risposta del vecchio accesso non deve chiudere quello appena aggiornato.
      if (requestSession.authenticated && session !== requestSession) throw new DOMException('Accesso aggiornato durante la richiesta.', 'AbortError');
      if (!response.ok) {
        if (response.status === 401 && session.authenticated) { showAccess({ authenticated: false, setupRequired: false }); inform('L’accesso è scaduto. Accedi di nuovo per continuare.', true); input(loginForm, 'email').focus(); }
        throw new Error(data?.error?.message || 'Non è stato possibile completare l’operazione. Riprova tra poco.');
      }
      return data as T;
    }

    async function act(form: HTMLFormElement | null, task: () => Promise<void>) {
      if (busy) return;
      busy = true;
      inform('Operazione in corso…');
      const buttons = form ? Array.from(form.querySelectorAll<HTMLButtonElement>('button')) : [];
      const previous = buttons.map(button => button.disabled);
      buttons.forEach(button => { button.disabled = true; });
      form?.setAttribute('aria-busy', 'true');
      try { await task(); } catch (error) { if (!lifetime.signal.aborted && !(error instanceof Error && error.name === 'AbortError')) inform(error instanceof Error ? error.message : 'Si è verificato un problema. Riprova.', true); }
      finally { busy = false; buttons.forEach((button, index) => { button.disabled = previous[index]; }); form?.removeAttribute('aria-busy'); }
    }

    function showAccess(next: Session) {
      session = next;
      csrfToken = next.csrfToken || '';
      el('[data-workspace]').hidden = !next.authenticated;
      el('[data-owner-controls]').hidden = !next.authenticated;
      el('[data-auth]').hidden = next.authenticated;
      if (next.authenticated) { el('[data-owner-email-label]').textContent = next.email || ''; input(accountForm, 'email').value = next.email || ''; document.dispatchEvent(new CustomEvent('agenda:authenticated', { detail: { email: next.email, csrfToken } })); return; }
      document.dispatchEvent(new CustomEvent('agenda:logout'));
      automation = undefined; closedDatesDraft = []; settingsDirty = false; serviceDrafts.clear(); reminderPeriod = 'today'; el<HTMLSelectElement>('[data-reminder-period]').value = 'today'; el('[data-reminder-summary]').textContent = ''; showPanel('overview', false);
      services = []; appointments = []; requests = []; reminders = []; settings = undefined; requestStatus = 'pending'; el<HTMLSelectElement>('[data-request-status]').value = requestStatus;
      el('[data-calendar]').replaceChildren(); el('[data-services]').replaceChildren(); el('[data-reminders]').replaceChildren(); el('[data-stats]').replaceChildren(); el('[data-automation]').replaceChildren();
      el('[data-requests]').replaceChildren(); el('[data-request-result]').replaceChildren(); el('[data-request-result]').hidden = true; el('[data-request-count]').textContent = '0';
      appointmentForm.reset(); passwordForm.reset(); accountForm.reset(); backupForm.reset(); settingsForm.reset(); createServiceForm.reset(); el('[data-hours]').replaceChildren(); el('[data-closed-dates]').replaceChildren(); el('[data-checklist]').replaceChildren(); el('[data-editor]').hidden = true;
      const setup = Boolean(next.setupRequired);
      el('[data-auth-title]').textContent = setup ? 'Benvenuta nella tua agenda' : 'Accedi alla tua agenda';
      el('[data-auth-intro]').textContent = setup ? (activationToken ? 'Imposta il tuo accesso privato per iniziare.' : 'Per il primo accesso serve il link di attivazione riservato a Jessica.') : 'Un accesso privato, riservato a Jessica.';
      setupForm.hidden = !setup || !activationToken;
      loginForm.hidden = setup;
    }

    async function loadCalendar() {
      const { from, to } = period();
      const result = await api<{ items: Appointment[] }>(`/api/admin/appointments?from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`);
      if (!session.authenticated || lifetime.signal.aborted) return;
      appointments = result.items; renderCalendar();
    }

    async function loadRequests() {
      const result = await api<{ items: BookingRequest[] }>(`/api/admin/requests?status=${encodeURIComponent(requestStatus)}&limit=100`);
      if (!session.authenticated || lifetime.signal.aborted) return;
      requests = result.items; renderRequests();
    }

    function reminderPath() { const date = reminderPeriod === 'all' ? '' : addDays(today(), reminderPeriod === 'tomorrow' ? 1 : 0); return `/api/admin/reminders?limit=100${date ? `&date=${encodeURIComponent(date)}` : ''}`; }
    async function loadReminders() {
      const path = reminderPath();
      const result = await api<{ items: Reminder[] }>(path);
      if (!session.authenticated || lifetime.signal.aborted || path !== reminderPath()) return;
      reminders = result.items; renderReminders();
    }

    async function loadAll() {
      const [serviceData, settingsData, reminderData, stats, automationData, requestData] = await Promise.all([
        api<{ items: Service[] }>('/api/admin/services'), api<Settings>('/api/admin/settings'), api<{ items: Reminder[] }>(reminderPath()),
        api<Record<string, number>>('/api/admin/stats'), api<Automation>('/api/admin/automation'),
        api<{ items: BookingRequest[] }>(`/api/admin/requests?status=${encodeURIComponent(requestStatus)}&limit=100`),
      ]);
      if (!session.authenticated || lifetime.signal.aborted) return;
      services = serviceData.items; settings = settingsData; automation = automationData; reminders = reminderData.items; requests = requestData.items;
      renderServices(); renderSettings(); renderReminders(); renderStats(stats); renderAutomation(automationData); renderOverview(); renderRequests(); populateServiceSelect();
      await loadCalendar();
    }

    async function refreshIncomingRequests() {
      if (!session.authenticated || lifetime.signal.aborted || document.hidden || busy || backgroundRefreshing) return;
      backgroundRefreshing = true;
      try {
        const panel = el('[data-panel=requests]');
        const editingRequest = Boolean(panel.querySelector('[data-request-confirm]:not([hidden]), .request-decline:not([hidden])'));
        const focusInRequest = Boolean(document.activeElement?.closest('[data-request-id]'));
        const refreshList = !panel.hidden && !editingRequest && !focusInRequest;
        const requestedStatus = requestStatus;
        const [stats, result] = await Promise.all([
          api<Record<string, number>>('/api/admin/stats'),
          refreshList ? api<{ items: BookingRequest[] }>(`/api/admin/requests?status=${encodeURIComponent(requestStatus)}&limit=100`) : Promise.resolve(null),
        ]);
        if (!session.authenticated || lifetime.signal.aborted || document.hidden || busy) return;
        renderStats(stats);
        // Se Jessica apre una conferma durante la richiesta, conserva il modulo e i dati inseriti.
        const nowEditing = Boolean(panel.querySelector('[data-request-confirm]:not([hidden]), .request-decline:not([hidden])'));
        const nowFocused = Boolean(document.activeElement?.closest('[data-request-id]'));
        if (result && requestStatus === requestedStatus && !panel.hidden && !nowEditing && !nowFocused && JSON.stringify(result.items) !== JSON.stringify(requests)) { requests = result.items; renderRequests(); }
      } catch { /* Un aggiornamento in background non interrompe il lavoro; resta disponibile Aggiorna richieste. */ }
      finally { backgroundRefreshing = false; }
    }

    function renderStats(stats: Record<string, number>) {
      const labels = [['pendingRequests', 'Richieste da confermare'], ['todayAppointments', 'Appuntamenti oggi'], ['upcomingAppointments', 'In programma'], ['pendingReminders', 'Promemoria in attesa'], ['sentThisMonth', 'Tentativi conteggiati questo mese']];
      el('[data-stats]').replaceChildren(...labels.map(([key, label]) => { const card = textNode('div', '', 'stat-card'); card.append(textNode('strong', String(stats[key] ?? 0)), textNode('span', label)); return card; }));
      el('[data-request-count]').textContent = String(stats.pendingRequests ?? 0);
    }

    function manualLink(appointment: { name: string; phone: string; date: string; time: string }) {
      const message = `Ciao ${appointment.name}, ti ricordiamo l’appuntamento da ${root.dataset.business} il ${prettyDate(appointment.date, false)} alle ${appointment.time}. Per modifiche o cancellazioni contatta il salone.`;
      const link = textNode('a', 'Apri WhatsApp', 'agenda-button secondary') as HTMLAnchorElement;
      link.href = whatsappHref(appointment.phone, message); link.target = '_blank'; link.rel = 'noopener noreferrer'; link.setAttribute('aria-label', `Prepara un promemoria WhatsApp per ${appointment.name}`); return link;
    }

    function confirmationLink(appointment: { name: string; phone: string; date: string; time: string; title: string }) {
      const message = `Ciao ${appointment.name}, il tuo appuntamento per ${appointment.title} da ${root.dataset.business} è confermato per ${prettyDate(appointment.date, false)} alle ${appointment.time}. Se hai bisogno di cambiare l’orario, scrivimi qui. A presto, Jessica`;
      const link = textNode('a', 'Comunica conferma', 'agenda-button secondary') as HTMLAnchorElement;
      link.href = whatsappHref(appointment.phone, message); link.target = '_blank'; link.rel = 'noopener noreferrer'; link.setAttribute('aria-label', `Prepara la conferma WhatsApp per ${appointment.name}`); return link;
    }

    function showRequestResult(appointment: Appointment) {
      const result = el('[data-request-result]');
      const actions = textNode('div', '', 'button-group');
      const close = textNode('button', 'Chiudi', 'agenda-button secondary') as HTMLButtonElement; close.type = 'button';
      on(close, 'click', () => { result.hidden = true; result.replaceChildren(); focus('#requests-title'); });
      actions.append(confirmationLink(appointment), close);
      result.replaceChildren(textNode('h3', 'Appuntamento confermato'), textNode('p', `${appointment.name} · ${appointment.title}`), textNode('p', `${prettyDate(appointment.date)} alle ${appointment.time} · ${appointment.durationMinutes} minuti`), textNode('p', 'È stato aggiunto all’agenda. Per avvisare la cliente, apri il messaggio di conferma e premi Invia su WhatsApp.', 'agenda-note'), actions);
      result.hidden = false;
    }

    function renderRequests() {
      const list = el('[data-requests]');
      if (!requests.length) {
        const copy = requestStatus === 'pending' ? 'Non ci sono richieste da confermare. Le richieste ricevute dal sito compariranno qui.' : requestStatus === 'confirmed' ? 'Non ci sono ancora richieste confermate.' : 'Non ci sono richieste non accettate.';
        list.replaceChildren(textNode('p', copy, 'agenda-card')); return;
      }
      list.replaceChildren(...requests.map(request => {
        const card = textNode('article', '', 'agenda-card request-card'); card.dataset.requestId = request.id;
        const heading = textNode('div', '', 'appointment-top');
        heading.append(textNode('h3', request.name), textNode('span', request.status === 'pending' ? 'Da confermare' : request.status === 'confirmed' ? 'Confermata' : 'Non accettata', 'status-badge')); card.append(heading);
        card.append(textNode('p', request.serviceName), textNode('p', `Orario desiderato: ${prettyDate(request.date)} alle ${request.time}`), textNode('p', request.phone, 'agenda-note'), textNode('small', `Riferimento ${request.reference}`));
        if (request.status !== 'pending') {
          if (request.appointment) {
            const appointment = request.appointment;
            card.append(textNode('p', appointment.status === 'cancelled' ? 'L’appuntamento collegato è stato annullato.' : `In agenda: ${prettyDate(appointment.date)} alle ${appointment.time} · ${appointment.durationMinutes} minuti`, 'agenda-note'));
            if (appointment.status === 'confirmed') card.append(confirmationLink({ ...appointment, name: request.name, phone: request.phone, title: appointment.title || request.serviceName }));
          }
          return card;
        }

        const actions = textNode('div', '', 'button-group request-actions');
        const confirm = textNode('button', 'Controlla e conferma', 'agenda-button') as HTMLButtonElement; confirm.type = 'button';
        const decline = textNode('button', 'Non accettare', 'agenda-button secondary') as HTMLButtonElement; decline.type = 'button';
        actions.append(confirm, decline); card.append(actions);

        const form = document.createElement('form'); form.className = 'request-confirm-form'; form.hidden = true; form.dataset.requestConfirm = request.id;
        const title = textNode('h4', 'Conferma i dettagli'); title.tabIndex = -1;
        const fields = textNode('div', '', 'form-grid');
        const field = (labelText: string, name: string, type: string, value: string) => {
          const label = textNode('label', labelText); const control = document.createElement('input'); control.name = name; control.type = type; control.value = value; control.required = true; label.append(control); fields.append(label); return control;
        };
        const date = field('Giorno', 'date', 'date', request.date); date.min = today();
        field('Ora', 'time', 'time', request.time);
        const knownDuration = services.find(service => service.id === request.serviceId)?.durationMinutes;
        const duration = field('Durata effettiva, in minuti', 'durationMinutes', 'number', knownDuration ? String(knownDuration) : ''); duration.min = '5'; duration.max = '480'; duration.step = '1';
        const save = textNode('button', 'Conferma appuntamento', 'agenda-button') as HTMLButtonElement; save.type = 'submit';
        const cancel = textNode('button', 'Lascia in attesa', 'agenda-button secondary') as HTMLButtonElement; cancel.type = 'button';
        const formActions = textNode('div', '', 'button-group'); formActions.append(save, cancel);
        form.append(title, fields, textNode('p', knownDuration ? 'Puoi cambiare giorno, orario e durata prima di confermare. Il sistema controlla gli impegni già presenti.' : 'Indica la durata reale del servizio. Puoi cambiare giorno e orario; il sistema controlla gli impegni già presenti.', 'agenda-note'), textNode('p', request.reminderConsent ? 'La cliente ha accettato il promemoria WhatsApp.' : 'La cliente non ha richiesto il promemoria WhatsApp.', 'agenda-note'), formActions);
        card.append(form);

        const declineBox = textNode('div', '', 'request-decline'); declineBox.hidden = true;
        declineBox.append(textNode('p', 'Vuoi rifiutare questa richiesta? Non verrà creato alcun appuntamento. Avvisa la cliente se avete già parlato dell’orario.'));
        const declineActions = textNode('div', '', 'button-group');
        const declineSave = textNode('button', 'Sì, non accettare', 'agenda-button secondary') as HTMLButtonElement; declineSave.type = 'button';
        const declineCancel = textNode('button', 'Torna alla richiesta', 'agenda-button secondary') as HTMLButtonElement; declineCancel.type = 'button';
        declineActions.append(declineSave, declineCancel); declineBox.append(declineActions); card.append(declineBox);
        on(confirm, 'click', () => { actions.hidden = true; declineBox.hidden = true; form.hidden = false; title.focus({ preventScroll: true }); });
        on(cancel, 'click', () => { form.hidden = true; actions.hidden = false; confirm.focus({ preventScroll: true }); });
        on(decline, 'click', () => { actions.hidden = true; form.hidden = true; declineBox.hidden = false; declineSave.focus({ preventScroll: true }); });
        on(declineCancel, 'click', () => { declineBox.hidden = true; actions.hidden = false; decline.focus({ preventScroll: true }); });
        on(form, 'submit', event => { event.preventDefault(); void act(form, async () => {
          if (!duration.value || !Number.isInteger(Number(duration.value))) { duration.focus(); throw new Error('Indica la durata effettiva del servizio, in minuti.'); }
          const result = await api<{ request: BookingRequest; appointment: Appointment }>(`/api/admin/requests/${encodeURIComponent(request.id)}/confirm`, 'POST', { date: input(form, 'date').value, time: input(form, 'time').value, durationMinutes: Number(duration.value) });
          selectedDate = result.appointment.date; el<HTMLInputElement>('[data-calendar-date]').value = selectedDate;
          showRequestResult(result.appointment); await loadAll(); inform('Richiesta confermata. L’appuntamento è in agenda.'); focus('#requests-title');
        }); });
        on(declineSave, 'click', () => { void act(null, async () => { await api(`/api/admin/requests/${encodeURIComponent(request.id)}/decline`, 'POST', {}); await loadAll(); inform('Richiesta non accettata. Non è stato creato un appuntamento.'); focus('#requests-title'); }); });
        return card;
      }));
    }

    function renderCalendar() {
      const { from, to } = period();
      const days: HTMLElement[] = [];
      for (let date = from; date <= to; date = addDays(date, 1)) {
        const section = textNode('section', '', 'calendar-day');
        const title = textNode('h3', prettyDate(date)); section.append(title);
        const items = appointments.filter(item => item.date === date).sort((a, b) => a.time.localeCompare(b.time));
        if (!items.length) section.append(textNode('p', 'Nessun appuntamento in questo giorno.', 'agenda-note empty-day'));
        for (const item of items) {
          const card = textNode('article', '', `appointment-card${item.status === 'cancelled' ? ' is-cancelled' : ''}`);
          const top = textNode('div', '', 'appointment-top'); top.append(textNode('strong', `${item.time} · ${item.durationMinutes} min`), textNode('span', item.status === 'cancelled' ? 'Annullato' : 'Confermato', 'status-badge')); card.append(top);
          card.append(textNode('h4', item.name), textNode('p', item.title || services.find(service => service.id === item.serviceId)?.name || 'Appuntamento'), textNode('p', item.phone, 'agenda-note'));
          const reference = textNode('small', `Riferimento ${item.reference}`); card.append(reference);
          const actions = textNode('div', '', 'button-group'); const edit = textNode('button', 'Modifica', 'agenda-button secondary') as HTMLButtonElement; edit.type = 'button'; on(edit, 'click', () => openEditor(item, edit)); actions.append(edit);
          if (item.status !== 'cancelled') actions.append(manualLink(item)); card.append(actions); section.append(card);
        }
        days.push(section);
      }
      el('[data-calendar]').replaceChildren(...days);
    }

    function populateServiceSelect() {
      const select = input<HTMLSelectElement>(appointmentForm, 'serviceId'); const current = select.value;
      select.replaceChildren(new Option('Altro appuntamento', ''), ...services.filter(service => service.listed !== false || service.id === current).map(service => new Option(service.name + (service.durationMinutes ? ` · ${service.durationMinutes} min` : ' · durata da impostare'), service.id)));
      select.value = current;
    }

    function openEditor(item?: Appointment, opener?: HTMLElement) {
      editingId = item?.id || ''; editorOpener = opener || null;
      appointmentForm.reset(); populateServiceSelect();
      el('#editor-title').textContent = item ? 'Modifica appuntamento' : 'Nuovo appuntamento';
      input(appointmentForm, 'date').value = item?.date || selectedDate; input(appointmentForm, 'time').value = item?.time || '';
      input<HTMLSelectElement>(appointmentForm, 'serviceId').value = item?.serviceId || '';
      input(appointmentForm, 'title').value = item?.title || ''; input(appointmentForm, 'durationMinutes').value = item ? String(item.durationMinutes) : '';
      input(appointmentForm, 'name').value = item?.name || ''; input(appointmentForm, 'phone').value = item?.phone || '';
      input(appointmentForm, 'reminderConsent').checked = Boolean(item?.reminderConsent); input<HTMLSelectElement>(appointmentForm, 'status').value = item?.status || 'confirmed';
      el('[data-status-field]').hidden = !item; el('[data-editor]').hidden = false;
      el('[data-editor]').scrollIntoView({ behavior: 'auto', block: 'start' }); focus('#editor-title');
    }

    function closeEditor() { el('[data-editor]').hidden = true; editingId = ''; appointmentForm.reset(); editorOpener?.focus({ preventScroll: true }); }

    function showPanel(panel: string, moveFocus = true) {
      activePanel = panel;
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach(item => { item.hidden = item.dataset.panel !== panel; });
      root.querySelectorAll<HTMLElement>('[data-tab]').forEach(button => { const selected = button.dataset.tab === panel; button.setAttribute('aria-pressed', String(selected)); button.classList.toggle('secondary', !selected); });
      document.dispatchEvent(new CustomEvent('agenda:panel', { detail: { panel } }));
      if (moveFocus) focus(`#${panel}-title`);
      if (panel === 'requests') void refreshIncomingRequests();
      if (panel === 'reminders' && session.authenticated) void act(null, async () => { await loadReminders(); inform('Elenco dei promemoria aggiornato.'); });
    }

    function renderOverview() {
      if (!settings) return;
      const listed = services.filter(service => service.listed !== false);
      const durations = listed.filter(service => service.durationMinutes).length;
      const automaticReady = listed.some(service => service.enabled && service.durationMinutes);
      const whatsappActive = Boolean(automation?.configured && automation?.enabled !== false && automation?.webhookConfigured !== false);
      const items = [
        { title: 'Calendario delle clienti', copy: settings.requestEnabled ? 'Le richieste arrivano nella tua agenda.' : 'Le richieste dal sito sono sospese.', ready: settings.requestEnabled, panel: 'settings' },
        { title: 'Servizi e durate', copy: `${listed.length} servizi visibili · ${durations} con durata impostata.`, ready: listed.length > 0 && durations === listed.length, panel: 'services' },
        { title: 'Orari del salone', copy: settings.openingHours.some(day => day.ranges.length) ? 'Controlla gli orari e aggiungi le chiusure straordinarie.' : 'Imposta i giorni e gli orari di apertura.', ready: settings.openingHours.some(day => day.ranges.length), panel: 'settings' },
        { title: 'Conferma automatica', copy: settings.bookingEnabled && automaticReady ? 'Attiva per i servizi abilitati, negli orari liberi.' : 'Decidi tu quando attivarla. Puoi già confermare le richieste a mano.', ready: settings.bookingEnabled && automaticReady, panel: 'settings' },
        { title: 'Promemoria WhatsApp', copy: whatsappActive ? (automation?.dailyLimit === 0 || automation?.monthlyLimit === 0 ? 'Collegato. Gli invii sono sospesi dai limiti impostati.' : 'Invii abilitati, secondo consenso e limiti. Verifica l’approvazione del modello su Meta.') : 'Completa il collegamento per abilitare gli invii automatici.', ready: whatsappActive && (automation?.dailyLimit || 0) > 0 && (automation?.monthlyLimit || 0) > 0, panel: 'connection' },
      ];
      el('[data-checklist]').replaceChildren(...items.map(item => {
        const li = textNode('li', '', 'checklist-item');
        const heading = textNode('div', '', 'appointment-top'); heading.append(textNode('strong', item.title), textNode('span', item.ready ? 'Pronto' : 'Da configurare', `status-badge${item.ready ? ' is-ready' : ''}`));
        const button = textNode('button', 'Apri', 'agenda-button secondary') as HTMLButtonElement; button.type = 'button'; button.setAttribute('aria-label', `Configura ${item.title.toLowerCase()}`); on(button, 'click', () => showPanel(item.panel));
        li.append(heading, textNode('p', item.copy, 'agenda-note'), button); return li;
      }));
    }

    function renderServices() {
      el('[data-services]').replaceChildren(...services.map(service => {
        const draft = serviceDrafts.get(service.id);
        const form = document.createElement('form'); form.className = 'agenda-card service-form'; form.dataset.serviceId = service.id;
        const top = textNode('div', '', 'appointment-top'); top.append(textNode('h3', service.name), textNode('span', service.listed !== false ? 'Visibile alle clienti' : 'Nascosto', 'status-badge')); form.append(top);
        const nameLabel = textNode('label', 'Nome del servizio'); const name = document.createElement('input'); name.name = 'name'; name.required = true; name.minLength = 2; name.maxLength = 100; name.value = draft?.name ?? service.name; nameLabel.append(name);
        const durationLabel = textNode('label', 'Durata, in minuti'); const duration = document.createElement('input'); duration.type = 'number'; duration.min = '5'; duration.max = '480'; duration.step = '1'; duration.name = 'durationMinutes'; duration.value = draft?.duration ?? (service.durationMinutes ? String(service.durationMinutes) : ''); duration.placeholder = 'Durata reale del servizio'; durationLabel.append(duration);
        const listedLabel = textNode('label', '', 'checkbox-label'); const listed = document.createElement('input'); listed.type = 'checkbox'; listed.name = 'listed'; listed.checked = draft?.listed ?? (service.listed !== false); listedLabel.append(listed, document.createTextNode('Mostra nel calendario delle clienti'));
        const enabledLabel = textNode('label', '', 'checkbox-label'); const enabled = document.createElement('input'); enabled.type = 'checkbox'; enabled.name = 'enabled'; enabled.checked = draft?.enabled ?? Boolean(service.enabled); enabled.disabled = !listed.checked; enabledLabel.append(enabled, document.createTextNode('Abilita la conferma automatica per questo servizio'));
        on(listed, 'change', () => { enabled.disabled = !listed.checked; if (!listed.checked) enabled.checked = false; });
        const rememberDraft = () => { serviceDrafts.set(service.id, { name: name.value, duration: duration.value, listed: listed.checked, enabled: listed.checked && enabled.checked }); };
        on(form, 'input', rememberDraft); on(form, 'change', rememberDraft);
        const save = textNode('button', 'Salva servizio', 'agenda-button secondary') as HTMLButtonElement; save.type = 'submit'; form.append(nameLabel, durationLabel, listedLabel, enabledLabel, textNode('small', 'Senza durata impostata, Jessica controlla e conferma le richieste. La conferma automatica richiede anche l’attivazione nelle impostazioni.'), save);
        on(form, 'submit', event => { event.preventDefault(); void act(form, async () => {
          if (enabled.checked && !duration.value) { duration.focus(); throw new Error('Imposta la durata prima di abilitare la conferma automatica.'); }
          await api(`/api/admin/services/${encodeURIComponent(service.id)}`, 'PATCH', { name: name.value.trim(), durationMinutes: duration.value ? Number(duration.value) : null, listed: listed.checked, enabled: listed.checked && enabled.checked }); serviceDrafts.delete(service.id); await loadAll(); inform(`Servizio ${name.value.trim()} salvato.`); focus('#services-title');
        }); }); return form;
      }));
    }

    function renderClosedDates() {
      const list = el('[data-closed-dates]');
      if (!closedDatesDraft.length) { list.replaceChildren(textNode('li', 'Non ci sono chiusure straordinarie.', 'agenda-note')); return; }
      list.replaceChildren(...closedDatesDraft.map(date => {
        const item = textNode('li', '', 'closure-item'); const button = textNode('button', 'Rimuovi', 'agenda-button secondary') as HTMLButtonElement; button.type = 'button'; button.setAttribute('aria-label', `Rimuovi la chiusura del ${prettyDate(date, false)}`);
        on(button, 'click', () => { settingsDirty = true; closedDatesDraft = closedDatesDraft.filter(value => value !== date); renderClosedDates(); inform('Chiusura rimossa dal modulo. Salva le impostazioni per applicare la modifica.'); });
        item.append(textNode('span', prettyDate(date)), button); return item;
      }));
    }

    function renderSettings() {
      if (!settings || settingsDirty) return;
      input(settingsForm, 'requestEnabled').checked = settings.requestEnabled !== false;
      input(settingsForm, 'bookingEnabled').checked = settings.bookingEnabled;
      input(settingsForm, 'economyMode').checked = settings.economyMode !== false;
      input(settingsForm, 'bookingDays').value = String(settings.bookingDays); input(settingsForm, 'reminderTime').value = settings.reminderTime;
      input(settingsForm, 'dailyReminderLimit').value = String(settings.dailyReminderLimit); input(settingsForm, 'monthlyReminderLimit').value = String(settings.monthlyReminderLimit);
      renderCostPreview();
      closedDatesDraft = [...settings.closedDates]; renderClosedDates();
      el<HTMLInputElement>('[data-closure-date]').value = '';
      el('[data-booking-help]').textContent = services.some(service => service.listed !== false && service.enabled && service.durationMinutes) ? 'I servizi abilitati vengono confermati solo negli orari effettivamente liberi. Gli altri servizi ricevono richieste, se abilitate.' : 'Prima di attivare la conferma automatica, abilita almeno un servizio e imposta la sua durata nella sezione Servizi. Puoi già ricevere richieste dal calendario.';
      el('[data-hours]').replaceChildren(...settings.openingHours.map(day => {
        const card = textNode('fieldset', '', 'hours-day'); card.dataset.hoursDay = day.day; const legend = textNode('legend', day.label); card.append(legend);
        const openLabel = textNode('label', '', 'checkbox-label'); const open = document.createElement('input'); open.type = 'checkbox'; open.name = `open-${day.day}`; open.checked = day.ranges.length > 0; openLabel.append(open, document.createTextNode('Aperto'));
        const ranges = textNode('div', '', 'hours-ranges'); ranges.hidden = !open.checked;
        const add = textNode('button', 'Aggiungi fascia', 'agenda-button secondary') as HTMLButtonElement; add.type = 'button'; add.hidden = !open.checked;
        const addRange = (range?: { opens: string; closes: string }) => {
          if (ranges.children.length >= 4) return;
          const row = textNode('div', '', 'hours-range');
          for (const [key, label] of [['opens', 'Dalle'], ['closes', 'Alle']]) { const wrapper = textNode('label', label); const control = document.createElement('input'); control.type = 'time'; control.dataset.rangeField = key; control.required = open.checked; control.disabled = !open.checked; control.value = range?.[key as 'opens' | 'closes'] || ''; control.setAttribute('aria-label', `${day.label}: ${label.toLowerCase()}`); wrapper.append(control); row.append(wrapper); }
          const remove = textNode('button', 'Rimuovi', 'agenda-button secondary range-remove') as HTMLButtonElement; remove.type = 'button'; remove.setAttribute('aria-label', `Rimuovi fascia di ${day.label}`); on(remove, 'click', () => { settingsDirty = true; row.remove(); if (!ranges.children.length) addRange(); add.disabled = ranges.children.length >= 4; }); row.append(remove); ranges.append(row); add.disabled = ranges.children.length >= 4;
        };
        day.ranges.forEach(range => addRange(range));
        on(open, 'change', () => { ranges.hidden = !open.checked; add.hidden = !open.checked; if (open.checked && !ranges.children.length) addRange(); ranges.querySelectorAll<HTMLInputElement>('input').forEach(control => { control.disabled = !open.checked; control.required = open.checked; }); });
        on(add, 'click', () => { settingsDirty = true; addRange(); ranges.lastElementChild?.querySelector<HTMLInputElement>('input')?.focus(); });
        card.append(openLabel, ranges, add); return card;
      }));
    }

    function renderCostPreview() {
      const economy = input(settingsForm, 'economyMode').checked;
      const daily = Number(input(settingsForm, 'dailyReminderLimit').value);
      const monthly = Number(input(settingsForm, 'monthlyReminderLimit').value);
      el('[data-effective-limits]').textContent = Number.isFinite(daily) && Number.isFinite(monthly) ? `Con queste impostazioni: massimo ${economy ? Math.min(daily, 10) : daily} tentativi al giorno e ${economy ? Math.min(monthly, 60) : monthly} al mese. Le modifiche si applicano dopo il salvataggio.` : 'Completa i limiti per vedere i valori effettivi.';
    }

    function renderAutomation(next: Automation) {
      const active = next.configured && next.enabled !== false && next.webhookConfigured !== false;
      const card = el('[data-automation]'); const title = textNode('h3', active ? 'Invii automatici abilitati' : next.configured ? 'Collegamento salvato, invii sospesi' : 'Invio automatico da collegare');
      const copy = textNode('p', active ? 'I promemoria con consenso vengono inviati la sera prima, secondo orario e limiti. Il modello deve essere approvato da Meta e il collegamento deve avere credenziali valide.' : 'L’agenda e le richieste funzionano. Completa il collegamento WhatsApp Business e abilita gli invii quando sei pronta. Al momento non partono promemoria automatici.');
      const button = textNode('button', 'Gestisci collegamento WhatsApp', 'agenda-button secondary') as HTMLButtonElement; button.type = 'button'; on(button, 'click', () => showPanel('connection'));
      card.replaceChildren(title, copy,
        textNode('p', `${next.economyMode ? 'Modalità risparmio attiva. ' : ''}Limiti effettivi: ${next.dailyLimit} tentativi al giorno e ${next.monthlyLimit} al mese.`, 'agenda-note'),
        textNode('p', `Limiti impostati: ${next.configuredDailyLimit} al giorno e ${next.configuredMonthlyLimit} al mese.`, 'agenda-note'),
        textNode('p', `Tentativi conteggiati questo mese: ${next.sentThisMonth}. Disponibili oggi: ${next.remainingToday}; questo mese: ${next.remainingThisMonth}.`, 'agenda-note'),
        textNode('p', 'Il conteggio include gli invii con esito incerto per evitare altre spese. Non indica messaggi consegnati e non sostituisce la fattura Meta.', 'agenda-note'), button);
      if (next.dailyLimit === 0 || next.monthlyLimit === 0) card.append(textNode('p', 'Gli invii sono sospesi perché un limite è impostato a 0.', 'agenda-note'));
    }

    function renderReminders() {
      const list = el('[data-reminders]');
      const day = addDays(today(), reminderPeriod === 'tomorrow' ? 1 : 0);
      el('[data-reminder-summary]').textContent = `${reminderPeriod === 'all' ? 'Tutti i promemoria' : `Promemoria previsti per ${prettyDate(day)}`} · ${reminders.length} promemoria. ${reminders.length === 100 ? 'Sono mostrati al massimo 100 record. Scegli Oggi o Domani per restringere l’elenco.' : 'La data si riferisce al promemoria, non al giorno dell’appuntamento.'}`;
      if (!reminders.length) { list.replaceChildren(textNode('p', reminderPeriod === 'all' ? 'Non ci sono ancora promemoria. Verranno pianificati per gli appuntamenti con consenso.' : 'Non ci sono promemoria previsti per questo giorno.', 'agenda-card')); return; }
      const dedupCopy: Record<string, string> = {
        already_reminded: 'Un promemoria per questo appuntamento è già stato inviato. Il nuovo orario non genera un secondo invio automatico: comunica la modifica alla cliente a mano.',
        prior_send_uncertain: 'L’invio precedente ha un esito incerto. Non parte un secondo promemoria automatico. Controlla la chat e comunica alla cliente l’eventuale cambio di orario a mano.',
        manual_sent: 'Il promemoria è stato registrato come inviato a mano. Non parte un secondo invio automatico. Se cambi l’orario, avvisa la cliente a mano.',
        after_cutoff: 'Appuntamento inserito dopo l’orario del promemoria: nessun invio automatico tardivo.',
        cancelled: 'L’appuntamento è stato annullato: nessun promemoria da inviare.',
        no_consent: 'La cliente non ha accettato il promemoria: nessun invio automatico.',
      };
      list.replaceChildren(...reminders.map(item => {
        const card = textNode('article', '', 'agenda-card reminder-card'); card.dataset.reminderId = item.id;
        const top = textNode('div', '', 'appointment-top'); top.append(textNode('h3', item.name), textNode('span', `${reminderLabels[item.status] || item.status}${item.staleRevision ? ' · versione precedente' : ''}`, 'status-badge')); card.append(top);
        card.append(textNode('p', `${item.staleRevision ? 'Orario attuale dell’appuntamento' : 'Appuntamento'}: ${prettyDate(item.date)} alle ${item.time}`));
        if (item.staleRevision) card.append(textNode('p', 'Il promemoria si riferisce a una versione precedente. Comunica alla cliente le modifiche all’appuntamento.', 'agenda-note'));
        if (item.dueAt) card.append(textNode('p', `Promemoria previsto: ${new Intl.DateTimeFormat('it-IT', { timeZone: 'Europe/Rome', dateStyle: 'short', timeStyle: 'short' }).format(new Date(item.dueAt))}`, 'agenda-note'));
        if (item.status === 'pending' && item.dueAt > Date.now()) card.append(textNode('p', 'È programmato per l’orario indicato. Non viene inviato in anticipo.', 'agenda-note'));
        if (item.status === 'needs_review') card.append(textNode('p', item.manualSentAt ? 'Il tentativo automatico resta con esito incerto e conteggiato. Hai registrato il successivo invio manuale; non partono altri promemoria automatici.' : 'L’esito dell’invio è incerto e il tentativo resta conteggiato. Controlla WhatsApp prima di mandare un altro messaggio: non viene riprovato automaticamente.', 'agenda-note'));
        if (item.status === 'skipped') card.append(textNode('p', dedupCopy[item.errorCode || ''] || 'Il promemoria non è stato inviato. Controlla lo stato dell’appuntamento, il consenso e i limiti.', 'agenda-note'));
        if (item.status === 'failed' && item.errorText) card.append(textNode('p', item.errorText, 'agenda-note'));
        if (item.manualSentAt) card.append(textNode('p', `Invio manuale registrato da Jessica il ${new Intl.DateTimeFormat('it-IT', { timeZone: 'Europe/Rome', dateStyle: 'short', timeStyle: 'short' }).format(new Date(item.manualSentAt))}. Questa dichiarazione non verifica la consegna del messaggio.`, 'agenda-note'));
        const alreadySent = Boolean(item.providerMessageId) || ['sending', 'accepted', 'delivered', 'read'].includes(item.status);
        const deduplicated = ['already_reminded', 'prior_send_uncertain', 'manual_sent'].includes(item.errorCode || '');
        const unavailable = ['cancelled', 'no_consent'].includes(item.errorCode || '');
        const nowTime = new Intl.DateTimeFormat('it-IT', { timeZone: 'Europe/Rome', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(new Date());
        const pastAppointment = item.date < today() || (item.date === today() && item.time <= nowTime);
        if (item.manualSentAt || alreadySent || deduplicated || unavailable || pastAppointment || !['pending', 'failed', 'skipped', 'needs_review'].includes(item.status)) return card;
        const actions = textNode('div', '', 'button-group'); const acknowledge = textNode('button', 'Ho inviato il promemoria', 'agenda-button secondary') as HTMLButtonElement; acknowledge.type = 'button'; acknowledge.dataset.manualAcknowledge = item.id;
        actions.append(manualLink(item), acknowledge); card.append(actions);
        const form = document.createElement('form'); form.className = 'manual-confirm-form'; form.hidden = true; form.dataset.manualConfirm = item.id;
        const heading = textNode('h4', 'Registra l’invio manuale'); heading.tabIndex = -1;
        const label = textNode('label', '', 'checkbox-label'); const declaration = document.createElement('input'); declaration.type = 'checkbox'; declaration.required = true; label.append(declaration, document.createTextNode(`Confermo di avere già inviato questo promemoria a ${item.name}.`));
        const confirm = textNode('button', 'Conferma invio manuale', 'agenda-button') as HTMLButtonElement; confirm.type = 'submit';
        const cancel = textNode('button', 'Torna al promemoria', 'agenda-button secondary') as HTMLButtonElement; cancel.type = 'button';
        const formActions = textNode('div', '', 'button-group'); formActions.append(confirm, cancel);
        form.append(heading, textNode('p', 'Registra l’invio solo dopo aver premuto Invia in WhatsApp. Questo comando non invia messaggi e ferma altri promemoria automatici per lo stesso appuntamento.', 'agenda-note'), label, formActions); card.append(form);
        on(acknowledge, 'click', () => { actions.hidden = true; form.hidden = false; heading.focus({ preventScroll: true }); });
        on(cancel, 'click', () => { form.hidden = true; actions.hidden = false; declaration.checked = false; acknowledge.focus({ preventScroll: true }); });
        on(form, 'submit', event => { event.preventDefault(); if (!declaration.checked) { declaration.focus(); return; } void act(form, async () => {
          await api<Reminder>(`/api/admin/reminders/${encodeURIComponent(item.id)}/manual`, 'POST', {}); await loadAll(); inform('Invio manuale registrato. Non è stato inviato alcun messaggio da questo comando.'); focus('#reminders-title');
        }); });
        return card;
      }));
    }

    on(loginForm, 'submit', event => { event.preventDefault(); void act(loginForm, async () => { showAccess(await api<Session>('/api/auth/login', 'POST', { email: input(loginForm, 'email').value.trim(), password: input(loginForm, 'password').value })); input(loginForm, 'password').value = ''; await loadAll(); showPanel('overview'); inform('Accesso riuscito. La tua area privata è pronta.'); }); });
    on(setupForm, 'submit', event => { event.preventDefault(); void act(setupForm, async () => { const password = input(setupForm, 'password').value; if (password !== input(setupForm, 'confirmation').value) { input(setupForm, 'confirmation').focus(); throw new Error('Le password non coincidono.'); } showAccess(await api<Session>('/api/auth/setup', 'POST', { token: activationToken, password, email: input(setupForm, 'email').value.trim() })); activationToken = ''; setupForm.reset(); await loadAll(); showPanel('overview'); inform('Area privata attivata. Le richieste del calendario sono nella sezione Richieste.'); }); });
    on(el('[data-logout]'), 'click', () => { void act(null, async () => { await api('/api/auth/logout', 'POST', {}); activationToken = ''; showAccess({ authenticated: false, setupRequired: false }); loginForm.reset(); input(loginForm, 'email').value = root.dataset.ownerEmail || ''; inform('Sei uscita dall’agenda.'); input(loginForm, 'email').focus(); }); });
    on(el('[data-new]'), 'click', () => openEditor(undefined, el('[data-new]')));
    root.querySelectorAll<HTMLElement>('[data-editor-close]').forEach(button => on(button, 'click', closeEditor));
    on(input<HTMLSelectElement>(appointmentForm, 'serviceId'), 'change', () => { const service = services.find(item => item.id === input<HTMLSelectElement>(appointmentForm, 'serviceId').value); input(appointmentForm, 'title').value = service?.name || ''; input(appointmentForm, 'durationMinutes').value = service?.durationMinutes ? String(service.durationMinutes) : ''; });
    on(appointmentForm, 'submit', event => { event.preventDefault(); void act(appointmentForm, async () => {
      const body = { serviceId: input<HTMLSelectElement>(appointmentForm, 'serviceId').value || null, title: input(appointmentForm, 'title').value.trim(), date: input(appointmentForm, 'date').value, time: input(appointmentForm, 'time').value, durationMinutes: Number(input(appointmentForm, 'durationMinutes').value), name: input(appointmentForm, 'name').value.trim(), phone: input(appointmentForm, 'phone').value.trim(), reminderConsent: input(appointmentForm, 'reminderConsent').checked, ...(editingId ? { status: input<HTMLSelectElement>(appointmentForm, 'status').value } : {}) };
      const appointment = await api<Appointment>(editingId ? `/api/admin/appointments/${encodeURIComponent(editingId)}` : '/api/admin/appointments', editingId ? 'PATCH' : 'POST', body); selectedDate = appointment.date; el<HTMLInputElement>('[data-calendar-date]').value = selectedDate; closeEditor(); await loadAll(); inform(appointment.status === 'cancelled' ? 'Appuntamento annullato. I promemoria ancora da inviare sono stati fermati.' : 'Appuntamento salvato.'); focus('#calendar-title');
    }); });
    on(settingsForm, 'submit', event => { event.preventDefault(); void act(settingsForm, async () => {
      if (!settings) return;
      const openingHours = settings.openingHours.map(day => {
        const card = el(`[data-hours-day="${day.day}"]`); const open = input(settingsForm, `open-${day.day}`).checked;
        const ranges = open ? Array.from(card.querySelectorAll<HTMLElement>('.hours-range')).map(row => {
          const start = row.querySelector<HTMLInputElement>('[data-range-field=opens]')!; const end = row.querySelector<HTMLInputElement>('[data-range-field=closes]')!;
          if (!start.value || !end.value || start.value >= end.value) { start.focus(); throw new Error(`Controlla gli orari di ${day.label}: l’apertura deve precedere la chiusura.`); }
          return { opens: start.value, closes: end.value };
        }) : []; return { day: day.day, label: day.label, ranges };
      });
      const closedDates = [...closedDatesDraft];
      await api('/api/admin/settings', 'PATCH', { requestEnabled: input(settingsForm, 'requestEnabled').checked, bookingEnabled: input(settingsForm, 'bookingEnabled').checked, bookingDays: Number(input(settingsForm, 'bookingDays').value), openingHours, closedDates, economyMode: input(settingsForm, 'economyMode').checked, reminderTime: input(settingsForm, 'reminderTime').value, dailyReminderLimit: Number(input(settingsForm, 'dailyReminderLimit').value), monthlyReminderLimit: Number(input(settingsForm, 'monthlyReminderLimit').value) }); settingsDirty = false; await loadAll(); inform('Impostazioni salvate.');
    }); });
    on(passwordForm, 'submit', event => { event.preventDefault(); void act(passwordForm, async () => { const password = input(passwordForm, 'password').value; if (password !== input(passwordForm, 'confirmation').value) { input(passwordForm, 'confirmation').focus(); throw new Error('Le password non coincidono.'); } const result = await api<Session>('/api/admin/password', 'POST', { currentPassword: input(passwordForm, 'currentPassword').value, password }); if (result.csrfToken) showAccess(result); else showAccess(await api<Session>('/api/auth/session')); passwordForm.reset(); inform('Password aggiornata. Gli altri accessi sono stati chiusi.'); }); });

    root.querySelectorAll<HTMLElement>('[data-tab]').forEach(button => on(button, 'click', () => showPanel(button.dataset.tab!)));
    root.querySelectorAll<HTMLElement>('[data-open-panel]').forEach(button => on(button, 'click', () => showPanel(button.dataset.openPanel!)));
    on(el('[data-open-calendar]'), 'click', () => { showPanel('calendar', false); openEditor(undefined, el('[data-open-calendar]')); });
    on(document, 'agenda:authentication-expired', () => { if (!session.authenticated) return; showAccess({ authenticated: false, setupRequired: false }); inform('L’accesso è scaduto. Accedi di nuovo per continuare.', true); input(loginForm, 'email').focus(); });
    on(document, 'agenda:configuration-changed', () => { if (!session.authenticated) return; void api<Automation>('/api/admin/automation').then(next => { if (!session.authenticated || lifetime.signal.aborted) return; automation = next; renderAutomation(next); renderOverview(); }).catch(() => {}); });
    on(document, 'agenda:new-appointment', event => { if (!session.authenticated || busy) return; const detail = (event as CustomEvent<{ name: string; phone: string }>).detail; if (!detail || typeof detail.name !== 'string' || typeof detail.phone !== 'string') return; showPanel('calendar', false); openEditor(); input(appointmentForm, 'name').value = detail.name; input(appointmentForm, 'phone').value = detail.phone; input(appointmentForm, 'date').focus(); });
    on(settingsForm, 'input', () => { settingsDirty = true; renderCostPreview(); }); on(settingsForm, 'change', () => { settingsDirty = true; renderCostPreview(); });
    on(accountForm, 'submit', event => { event.preventDefault(); void act(accountForm, async () => { const next = await api<Session>('/api/admin/account', 'PATCH', { email: input(accountForm, 'email').value.trim(), currentPassword: input(accountForm, 'currentPassword').value }); accountForm.reset(); showAccess(next); document.dispatchEvent(new CustomEvent('agenda:panel', { detail: { panel: activePanel } })); inform('Email aggiornata. Gli altri accessi sono stati chiusi.'); }); });
    on(createServiceForm, 'submit', event => { event.preventDefault(); void act(createServiceForm, async () => {
      const duration = input(createServiceForm, 'durationMinutes'); const enabled = input(createServiceForm, 'enabled').checked; const listed = input(createServiceForm, 'listed').checked;
      if (enabled && (!listed || !duration.value)) { duration.focus(); throw new Error('Per la conferma automatica, mostra il servizio e indica la durata reale.'); }
      await api('/api/admin/services', 'POST', { name: input(createServiceForm, 'name').value.trim(), durationMinutes: duration.value ? Number(duration.value) : null, enabled, listed }); createServiceForm.reset(); await loadAll(); inform('Nuovo servizio aggiunto.'); focus('#services-title');
    }); });
    on(el('[data-closure-add]'), 'click', () => {
      const control = el<HTMLInputElement>('[data-closure-date]'); if (!control.value || !/^\d{4}-\d{2}-\d{2}$/.test(control.value)) { control.focus(); inform('Scegli il giorno di chiusura.', true); return; }
      if (closedDatesDraft.includes(control.value)) { inform('Questo giorno è già tra le chiusure.'); return; }
      settingsDirty = true; closedDatesDraft = [...closedDatesDraft, control.value].sort(); control.value = ''; renderClosedDates(); inform('Giorno aggiunto al modulo. Salva le impostazioni per applicare la chiusura.');
    });
    on(backupForm, 'submit', event => { event.preventDefault(); void act(backupForm, async () => {
      const response = await fetch('/api/admin/backup', { method: 'POST', credentials: 'same-origin', signal: lifetime.signal, headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken }, body: JSON.stringify({ currentPassword: input(backupForm, 'currentPassword').value }) });
      if (!response.ok) { const data = await response.json().catch(() => null); if (response.status === 401) { showAccess({ authenticated: false, setupRequired: false }); } throw new Error(data?.error?.message || 'Non è stato possibile scaricare il backup. Riprova.'); }
      const type = response.headers.get('Content-Type') || ''; if (!type.includes('octet-stream') && !type.includes('sqlite')) throw new Error('Il backup ricevuto non è valido. Riprova.');
      const blob = await response.blob(); const url = URL.createObjectURL(blob); const link = document.createElement('a'); link.href = url; link.download = `agenda-salone-${today()}.sqlite`; document.body.append(link); link.click(); link.remove(); window.setTimeout(() => URL.revokeObjectURL(url), 10_000); backupForm.reset(); inform('Backup scaricato. Conservalo in un posto sicuro.');
    }); });
    on(exportForm, 'submit', event => { event.preventDefault(); void act(exportForm, async () => {
      const from = input(exportForm, 'from').value; const to = input(exportForm, 'to').value;
      const difference = (Date.parse(to + 'T12:00:00Z') - Date.parse(from + 'T12:00:00Z')) / 86_400_000;
      if (!Number.isFinite(difference) || difference < 0 || difference > 365) { input(exportForm, 'to').focus(); throw new Error('Scegli un periodo valido di massimo un anno.'); }
      const response = await fetch(`/api/admin/export.csv?from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`, { credentials: 'same-origin', signal: lifetime.signal });
      if (!response.ok) { const data = await response.json().catch(() => null); if (response.status === 401) showAccess({ authenticated: false, setupRequired: false }); throw new Error(data?.error?.message || 'Non è stato possibile esportare gli appuntamenti.'); }
      if (!response.headers.get('Content-Type')?.includes('text/csv')) throw new Error('Il file ricevuto non è un’esportazione valida. Riprova.');
      const url = URL.createObjectURL(await response.blob()); const link = document.createElement('a'); link.href = url; link.download = `appuntamenti-${from}-${to}.csv`; document.body.append(link); link.click(); link.remove(); window.setTimeout(() => URL.revokeObjectURL(url), 10_000); inform('Appuntamenti esportati per il periodo scelto.');
    }); });
    async function moveDate(date: string) { selectedDate = date; el<HTMLInputElement>('[data-calendar-date]').value = selectedDate; await loadCalendar(); inform('Agenda aggiornata.'); }
    el<HTMLInputElement>('[data-calendar-date]').value = selectedDate;
    input(exportForm, 'from').value = addDays(selectedDate, -7); input(exportForm, 'to').value = addDays(selectedDate, 7);
    on(el('[data-date-prev]'), 'click', () => { void act(null, () => moveDate(addDays(selectedDate, view === 'week' ? -7 : -1))); });
    on(el('[data-date-next]'), 'click', () => { void act(null, () => moveDate(addDays(selectedDate, view === 'week' ? 7 : 1))); });
    on(el('[data-today]'), 'click', () => { void act(null, () => moveDate(today())); });
    on(el('[data-calendar-date]'), 'change', () => { const date = el<HTMLInputElement>('[data-calendar-date]').value; if (date) void act(null, () => moveDate(date)); });
    on(el('[data-refresh]'), 'click', () => { void act(null, async () => { await loadAll(); inform('Agenda aggiornata.'); }); });
    on(el('[data-reminders-refresh]'), 'click', () => { void act(null, async () => { await loadReminders(); inform('Elenco dei promemoria aggiornato.'); }); });
    on(el('[data-reminder-period]'), 'change', () => { const control = el<HTMLSelectElement>('[data-reminder-period]'); if (busy) { control.value = reminderPeriod; return; } reminderPeriod = control.value; void act(null, async () => { await loadReminders(); inform('Elenco dei promemoria aggiornato.'); }); });
    on(el('[data-requests-refresh]'), 'click', () => { void act(null, async () => { await loadAll(); inform('Richieste aggiornate.'); }); });
    on(el('[data-request-status]'), 'change', () => { if (busy) { el<HTMLSelectElement>('[data-request-status]').value = requestStatus; return; } void act(null, async () => { requestStatus = el<HTMLSelectElement>('[data-request-status]').value; await loadRequests(); inform('Elenco delle richieste aggiornato.'); }); });
    root.querySelectorAll<HTMLElement>('[data-view]').forEach(button => on(button, 'click', () => { void act(null, async () => { view = button.dataset.view!; root.querySelectorAll<HTMLElement>('[data-view]').forEach(candidate => { const selected = candidate === button; candidate.setAttribute('aria-pressed', String(selected)); candidate.classList.toggle('secondary', !selected); }); await loadCalendar(); inform('Vista calendario aggiornata.'); }); }));

    const incomingInterval = window.setInterval(() => { void refreshIncomingRequests(); }, 60_000);
    on(document, 'visibilitychange', () => { if (!document.hidden) void refreshIncomingRequests(); });
    dispose = () => { window.clearInterval(incomingInterval); lifetime.abort(); activationToken = ''; csrfToken = ''; session = { authenticated: false }; services = []; appointments = []; requests = []; reminders = []; settings = undefined; activeRoot = null; };
    void act(null, async () => { showAccess(await api<Session>('/api/auth/session')); if (session.authenticated) { await loadAll(); showPanel('overview', false); inform('La tua area privata è pronta.'); } else inform(session.setupRequired ? 'Il primo accesso è riservato a Jessica.' : 'Accedi per vedere e gestire gli appuntamenti.'); });
  }

  document.addEventListener('astro:before-swap', () => { dispose?.(); dispose = undefined; });
  document.addEventListener('astro:page-load', initAgenda);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAgenda, { once: true }); else initAgenda();
</script>

<style is:global>
  .agenda { padding-block: 2.5rem 5rem; }
