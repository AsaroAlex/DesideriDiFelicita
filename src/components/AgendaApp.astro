    function suggestedVariantName(source: Service) {
      const normalize = (name: string) => name.trim().replace(/\s+/g, ' ').normalize('NFKC').toLocaleLowerCase('it-IT'); const names = new Set(services.map(service => normalize(service.name)));
      for (let index = 1; ; index++) { const suffix = ` · variante${index === 1 ? '' : ` ${index}`}`; const name = source.name.slice(0, 100 - suffix.length).trimEnd() + suffix; if (!names.has(normalize(name))) return name; }
    }

    function beginServiceVariant(id: string) {
      serviceCreationTransition(() => {
        const source = services.find(service => service.id === id);
        if (!source) { inform('Il servizio di origine non è più disponibile. Aggiorna il catalogo.', true); return; }
        resetServiceCreation(); serviceVariantOrigin = { id: source.id, name: source.name };
        input(createServiceForm, 'name').value = suggestedVariantName(source); input<HTMLTextAreaElement>(createServiceForm, 'description').value = source.description || '';
        input(createServiceForm, 'durationMinutes').value = source.durationMinutes === null ? '' : String(source.durationMinutes);
        input(createServiceForm, 'price').value = source.priceCents === null || source.priceCents === undefined ? '' : (source.priceCents / 100).toFixed(2);
        input(createServiceForm, 'priceFrom').checked = Boolean(source.priceFrom); input(createServiceForm, 'bufferAfterMinutes').value = String(source.bufferAfterMinutes || 0);
        input(createServiceForm, 'listed').checked = true; input(createServiceForm, 'enabled').checked = false;
        el('[data-service-create-title]').textContent = 'Crea una variante'; el('[data-service-create-save]').textContent = 'Crea variante'; el('[data-service-variant-close]').hidden = false;
        const origin = el('[data-service-variant-origin]'); origin.textContent = `Da «${source.name}»: sono stati copiati gli ultimi dati salvati. Puoi cambiare ogni campo. La variante è un servizio separato: le modifiche future ai due servizi resteranno indipendenti. La conferma automatica parte disattivata. Il servizio verrà creato solo quando premi Crea variante.`; origin.hidden = false;
        serviceCreateBaseline = serviceCreationSignature(); createServiceForm.scrollIntoView({ behavior: 'auto', block: 'start' }); input(createServiceForm, 'name').focus();
      });
    }

    function renderServices() {
      const query = serviceSearch.trim().normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('it-IT');
      const visibleCount = services.filter(service => service.listed !== false).length; const archivedCount = services.length - visibleCount;
