    function openEditor(item?: Appointment, opener?: HTMLElement, prefill?: Partial<Appointment>, moveOnly = false) {
      if (busy) return;
      editorTransition(() => {
        editingId = item?.id || ''; editorOpener = opener || null; appointmentForm.reset();
        const value = item || prefill; populateServiceSelect(value?.serviceId || '');
        el('#editor-title').textContent = item ? (moveOnly ? 'Sposta appuntamento' : 'Modifica appuntamento') : 'Nuovo appuntamento';
        input(appointmentForm, 'date').value = value?.date ?? selectedDate; input(appointmentForm, 'time').value = value?.time || '';
        input(appointmentForm, 'title').value = value?.title || ''; input(appointmentForm, 'durationMinutes').value = value?.durationMinutes ? String(value.durationMinutes) : '';
        input(appointmentForm, 'name').value = value?.name || ''; input(appointmentForm, 'phone').value = value?.phone || ''; input<HTMLTextAreaElement>(appointmentForm, 'notes').value = item?.notes || '';
        input(appointmentForm, 'reminderConsent').checked = item ? Boolean(item.reminderConsent) : false; input<HTMLSelectElement>(appointmentForm, 'status').value = item?.status || 'confirmed';
        el('[data-status-field]').hidden = !item || (item.outcome || 'scheduled') !== 'scheduled'; el('[data-editor]').hidden = false; el('[data-editor-guard]').hidden = true; pendingEditorTransition = null; editorBaseline = editorSignature();
        el('[data-editor]').scrollIntoView({ behavior: 'auto', block: 'start' }); if (moveOnly || prefill?.name) input(appointmentForm, 'date').focus(); else focus('#editor-title');
