---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { withBase } from '../lib/href';
import { heroImage } from '../data/images';
import WhatsappButton from './WhatsappButton.astro';
---

<section class="hero">
  <span class="hero__glow hero__glow--gold" aria-hidden="true"></span>
  <span class="hero__glow hero__glow--blue" aria-hidden="true"></span>

  <div class="container hero__inner">
    <div class="hero__content">
      <p class="eyebrow hero__a1">{site.role} · Galliera (BO)</p>
      <h1 class="hero__title hero__a2">
        La bellezza nasce da un <em class="italic-accent">desiderio</em>, la felicità
        lo rende <em class="italic-accent">reale</em>.
      </h1>
      <p class="lead hero__desc hero__a3">
        {site.tagline} Salone di parrucchiera a Galliera (BO): taglio, colore,
        balayage e cura del riccio, su misura per te.
      </p>
      <div class="hero__actions hero__a4">
        <a class="btn btn--primary" href={withBase('/galleria')}>Guarda i lavori</a>
        <WhatsappButton label="WhatsApp" class="hero__wa" />
      </div>
    </div>

    <div class="hero__media hero__a3">
      {
        heroImage ? (
          <Image
            src={heroImage}
            alt={`${site.ownerName}, hair stylist del salone ${site.businessName}`}
            class="hero__img"
            widths={[480, 768, 1100]}
            sizes="(min-width: 960px) 45vw, 90vw"
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <div class="hero__placeholder" aria-hidden="true">
            <div class="hero__frame">
              <span class="hero__monogram">Df</span>
              <span class="hero__placeholder-note">la tua foto qui</span>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(70% 90% at 88% 4%, var(--color-blush-soft) 0%, transparent 55%),
      linear-gradient(180deg, var(--color-bg) 0%, var(--color-surface-alt) 100%);
    padding-block: clamp(2.8rem, 1rem + 6vw, 5.8rem);
  }

  .hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.5;
    pointer-events: none;
  }
  .hero__glow--gold {
    width: 26rem;
    height: 26rem;
    top: -8rem;
    right: -6rem;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-gold) 40%, transparent), transparent 70%);
  }
  .hero__glow--blue {
    width: 22rem;
    height: 22rem;
    bottom: -10rem;
    left: -8rem;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-primary) 30%, transparent), transparent 70%);
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: 1.08fr 0.92fr;
    }
  }

  .hero__title {
    margin-top: var(--space-xs);
    font-size: var(--fs-700);
    max-width: 15ch;
  }
  .hero__title em {
    color: var(--color-gold-strong);
  }
  .hero__desc {
    margin-top: var(--space-lg);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }
  .hero__actions :global(.hero__wa) {
    --btn-bg: transparent;
    --btn-fg: var(--color-primary-strong);
    border-color: color-mix(in srgb, var(--color-primary) 26%, transparent);
  }
  .hero__actions :global(.hero__wa:hover) {
    --btn-bg: var(--color-whatsapp);
    --btn-fg: #fff;
  }

  .hero__media {
    justify-self: center;
    width: 100%;
  }
  .hero__img {
    width: 100%;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    object-fit: cover;
    aspect-ratio: 4 / 5;
  }
  .hero__placeholder {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-xl);
    padding: 0.75rem;
    background:
      linear-gradient(150deg, var(--color-blush-soft) 0%, #e9e3ec 55%, color-mix(in srgb, var(--color-primary) 18%, #fff) 100%);
    box-shadow: var(--shadow-lg);
  }
  .hero__frame {
    height: 100%;
    border: 1px solid color-mix(in srgb, var(--color-gold) 55%, transparent);
    border-radius: calc(var(--radius-xl) - 8px);
    display: grid;
    place-content: center;
    gap: 0.4rem;
    text-align: center;
  }
  .hero__monogram {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(4rem, 11vw, 7.5rem);
    line-height: 1;
    color: var(--color-primary);
  }
  .hero__placeholder-note {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold-strong);
  }

  /* Ingresso animato leggero (solo se l'utente non ha ridotto il movimento) */
  @media (prefers-reduced-motion: no-preference) {
    .hero__a1,
    .hero__a2,
    .hero__a3,
    .hero__a4 {
      opacity: 0;
      animation: hero-in 0.8s var(--ease-out) forwards;
    }
    .hero__a1 {
      animation-delay: 0.05s;
    }
    .hero__a2 {
      animation-delay: 0.16s;
    }
    .hero__a3 {
      animation-delay: 0.28s;
    }
    .hero__a4 {
      animation-delay: 0.4s;
    }
    @keyframes hero-in {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
