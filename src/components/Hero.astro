---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { telHref } from '../lib/contact';
import { heroImage } from '../data/images';
import WhatsappButton from './WhatsappButton.astro';
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="eyebrow">{site.category}</p>
      <h1 class="hero__title">{site.slogan}</h1>
      <p class="lead hero__desc">{site.description}</p>
      <div class="hero__actions">
        <WhatsappButton label="Prenota su WhatsApp" />
        <a class="btn btn--outline" href={telHref(site.phone)}>
          <svg class="btn__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.3 1l-2.2 2.2Z"
            />
          </svg>
          Chiama ora
        </a>
      </div>
      <p class="note hero__note">Recapiti in fase di conferma.</p>
    </div>

    <div class="hero__media">
      {
        heroImage ? (
          <Image
            src={heroImage}
            alt={`Interno del salone ${site.businessName}`}
            class="hero__img"
            widths={[480, 768, 1100]}
            sizes="(min-width: 960px) 45vw, 90vw"
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <div class="hero__placeholder" aria-hidden="true">
            <span class="hero__monogram">Df</span>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background:
      radial-gradient(80% 120% at 100% 0%, var(--color-blush) 0%, transparent 55%),
      linear-gradient(180deg, var(--color-bg) 0%, var(--color-surface-alt) 100%);
    padding-block: clamp(2.5rem, 1rem + 8vw, 6rem);
    overflow: hidden;
  }
  .hero__inner {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
  .hero__title {
    margin-top: var(--space-xs);
    font-size: var(--fs-700);
    max-width: 16ch;
  }
  .hero__desc {
    margin-top: var(--space-lg);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }
  .hero__note {
    margin-top: var(--space-sm);
  }
  .hero__img {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    object-fit: cover;
    aspect-ratio: 4 / 5;
  }
  .hero__placeholder {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 120% at 0% 0%, var(--color-blush), transparent 60%),
      linear-gradient(160deg, var(--color-primary) 0%, var(--color-primary-strong) 100%);
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-lg);
  }
  .hero__monogram {
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 7rem);
    color: rgba(255, 255, 255, 0.92);
    letter-spacing: 0.02em;
  }
</style>
