---
import { withBase } from '../lib/href';

interface Props {
  items: { name: string; href: string }[];
}
const { items } = Astro.props;
---

<nav class="breadcrumbs container" aria-label="Percorso di navigazione">
  <ol role="list">
    {
      items.map((item, i) => (
        <li>
          {i < items.length - 1 ? (
            <a href={withBase(item.href)} class="link-underline">
              {item.name}
            </a>
          ) : (
            <span aria-current="page">{item.name}</span>
          )}
          {i < items.length - 1 && (
            <span class="sep" aria-hidden="true">
              /
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    padding-top: var(--space-lg);
  }
  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5em;
    margin: 0;
    font-size: var(--fs-100);
    color: var(--color-muted);
  }
  li {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }
  .sep {
    color: var(--color-gold);
  }
  [aria-current='page'] {
    color: var(--color-ink-soft);
  }
</style>
