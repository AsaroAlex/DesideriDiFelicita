---
import { site } from '../data/site';
import { telHref } from '../lib/contact';
import WhatsappButton from './WhatsappButton.astro';

const c = site.confirmed;
---

<div class="contact stack">
  <div>
    <h3 class="contact__h">Indirizzo</h3>
    <address class="contact__addr">
      {site.address.street}<br />
      {site.address.postalCode} {site.address.city} ({site.address.province})
      {!c.address && <span class="badge-tbc">da confermare</span>}
    </address>
  </div>

  <div>
    <h3 class="contact__h">Orari</h3>
    <ul class="contact__list" role="list">
      {site.openingHours.map((o) => <li>{o.label}: {o.opens}–{o.closes}</li>)}
    </ul>
    {!c.openingHours && <span class="badge-tbc">da confermare</span>}
  </div>

  <div>
    <h3 class="contact__h">Telefono</h3>
    <p><a class="link-underline" href={telHref(site.phone)}>{site.phone}</a></p>
  </div>

  <div>
    <h3 class="contact__h">Email</h3>
    <p><a class="link-underline" href={`mailto:${site.email}`}>{site.email}</a></p>
  </div>

  <div>
    <h3 class="contact__h">Prenotazioni</h3>
    <p class="note">Su WhatsApp, al telefono o in DM su Instagram.</p>
  </div>

  <div class="contact__actions">
    <WhatsappButton />
    <a class="btn btn--outline" href={telHref(site.phone)}>Chiama</a>
    <a class="btn btn--outline" href={site.instagramUrl} target="_blank" rel="noopener">
      Instagram
    </a>
  </div>
</div>

<style>
  .contact__h {
    font-family: var(--font-body);
    font-size: 0.74rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-gold-strong);
    margin-bottom: var(--space-2xs);
  }
  .contact__addr {
    font-style: normal;
    line-height: var(--lh-normal);
  }
  .contact__list {
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
  }
</style>
