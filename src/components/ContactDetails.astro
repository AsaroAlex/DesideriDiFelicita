---
import { site } from '../data/site';
import { telHref } from '../lib/contact';
import { withBase } from '../lib/href';
import WhatsappButton from './WhatsappButton.astro';

interface Props {
  headingLevel?: 'h2' | 'h3';
}
const { headingLevel: Heading = 'h3' } = Astro.props;
const c = site.confirmed;
---

<div class="contact stack">
  <div>
    <Heading class="contact__h">Indirizzo</Heading>
    <address class="contact__addr">
      {site.address.street}<br />
      {site.address.postalCode} {site.address.city} ({site.address.province})
      {!c.address && <span class="badge-tbc">da confermare</span>}
    </address>
  </div>

  <div>
    <Heading class="contact__h">Orari</Heading>
    <ul class="contact__hours" role="list">
      {
        site.openingHours.map((o) => (
          <li class={o.ranges.length === 0 ? 'is-closed' : ''}>
            <span class="contact__day">{o.label}</span>
            <span>
              {o.ranges.length
                ? o.ranges.map((r) => `${r.opens}–${r.closes}`).join(' · ')
                : 'Chiuso'}
            </span>
          </li>
        ))
      }
    </ul>
    {!c.openingHours && <span class="badge-tbc">da confermare</span>}
  </div>

  <div>
    <Heading class="contact__h">Telefono</Heading>
    <p><a class="link-underline" href={telHref(site.phone)}>{site.phone}</a></p>
  </div>

  <div>
    <Heading class="contact__h">Email</Heading>
    <p><a class="link-underline" href={`mailto:${site.email}`}>{site.email}</a></p>
  </div>

  <div>
    <Heading class="contact__h">Prenotazioni</Heading>
    <p class="note">
      Consulta il calendario per scegliere un appuntamento. Per una consulenza
      o un servizio su misura, scrivici su WhatsApp o chiamaci.
    </p>
  </div>

  <div class="contact__actions">
    <a class="btn btn--primary" href={withBase('/prenota')}>Prenota</a>
    <WhatsappButton />
    <a class="btn btn--outline" href={telHref(site.phone)}>Chiama</a>
    <a class="btn btn--outline" href={site.instagramUrl} target="_blank" rel="noopener">
      Instagram
    </a>
  </div>
</div>

<style>
  .contact__h {
    font-family: var(--font-body);
    font-size: 0.74rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-gold-strong);
    margin-bottom: var(--space-2xs);
  }
  .contact__addr {
    font-style: normal;
    line-height: var(--lh-normal);
  }
  .contact__hours {
    margin: 0;
    display: grid;
    gap: 0.3rem;
    max-width: 22rem;
  }
  .contact__hours li {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .contact__day {
    color: var(--color-ink-soft);
  }
  .contact__hours li.is-closed span:last-child {
    color: var(--color-muted);
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
  }
</style>
