---
import { withBase } from '../lib/href';
---
<span data-runtime-business data-config-url={withBase('api/public/config')} hidden></span>
<script>
  import { getPublicConfig } from '../lib/public-config';

  let root: HTMLElement | null = null;
  async function syncBusiness() {
    const next = document.querySelector<HTMLElement>('[data-runtime-business]');
    if (!next || next === root) return;
    root = next;
    try {
      const config = await getPublicConfig(next.dataset.configUrl!);
      if (root !== next || !next.isConnected || !config) return;
      const hours = config.openingHours;
      for (const entry of hours || []) {
        const text = entry.ranges.length ? entry.ranges.map(range => `${range.opens}–${range.closes}`).join(' · ') : 'Chiuso';
        document.querySelectorAll<HTMLElement>('[data-public-hours] [data-hour-day]').forEach(row => {
          if (row.dataset.hourDay !== entry.day) return;
          const value = row.querySelector('[data-hour-value]');
          if (value) value.textContent = text; else row.textContent = `${entry.label}: ${text}`;
          row.classList.toggle('is-closed', !entry.ranges.length);
        });
      }
      document.querySelectorAll<HTMLScriptElement>('script[type="application/ld+json"]').forEach(script => {
        try {
          const schema = JSON.parse(script.textContent || '{}');
          if (schema['@type'] !== 'HairSalon') return;
          if (hours) {
            schema.openingHoursSpecification = hours.flatMap(day => day.ranges.map(range => ({
              '@type': 'OpeningHoursSpecification', dayOfWeek: `https://schema.org/${day.day}`,
              opens: range.opens, closes: range.closes,
            })));
          }
          if (config.catalog) {
            const services = config.catalog.filter(service => service.listed);
            if (services.length) {
              schema.hasOfferCatalog = {
                '@type': 'OfferCatalog', name: 'Servizi',
                itemListElement: services.map(service => ({
                  '@type': 'Offer',
                  itemOffered: { '@type': 'Service', name: service.name, description: service.description },
                })),
              };
            } else delete schema.hasOfferCatalog;
          }
          script.textContent = JSON.stringify(schema);
        } catch { /* Non-business structured data remains intact. */ }
      });
    } catch { /* Static confirmed business data remains available offline and on Pages. */ }
  }
  document.addEventListener('astro:before-swap', () => { root = null; });
  document.addEventListener('astro:page-load', () => { void syncBusiness(); });
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => { void syncBusiness(); }, {once:true}); else void syncBusiness();
</script>
