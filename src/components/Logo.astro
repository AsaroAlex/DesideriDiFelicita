---
/**
 * Logo Desideri di Felicità — wordmark tipografico.
 * Niente monogramma: il marchio resta pulito e leggibile in header/footer.
 *
 * Props:
 *  - variant: 'horizontal' (default) | 'stacked'
 *  - theme:   'light' (default, su fondo chiaro) | 'dark' (su fondo scuro)
 *  - tagline: mostra "Jessica Asaro · Hair Stylist" (default true)
 *  - emblemOnly: solo il marchio, senza testo (avatar/icona)
 */
interface Props {
  variant?: 'horizontal' | 'stacked';
  theme?: 'light' | 'dark';
  tagline?: boolean;
  emblemOnly?: boolean;
  class?: string;
}
const {
  variant = 'horizontal',
  theme = 'light',
  tagline = true,
  emblemOnly = false,
  class: className = '',
} = Astro.props;
---

<span
  class:list={[
    'logo',
    `logo--${variant}`,
    `logo--${theme}`,
    emblemOnly && 'logo--emblem-only',
    className,
  ]}
>
  {
    !emblemOnly && (
      <span class="logo__text">
        <span class="logo__name">Desideri di felicità</span>
        {tagline && <span class="logo__tag">Jessica Asaro · Hair Stylist</span>}
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
    /* colori del marchio per tema */
    --logo-name: var(--color-primary-strong, #34425c);
    --logo-tag: var(--color-gold-strong, #a6864a);
  }
  .logo--dark {
    --logo-name: var(--color-on-dark, #eef1f5);
    --logo-tag: var(--color-gold-on-dark, #d4b277);
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 0.22em;
  }
  .logo__name {
    font-family: var(--font-display);
    font-weight: 440;
    font-size: 1.48rem;
    letter-spacing: 0;
    line-height: 0.94;
    color: var(--logo-name);
  }
  .logo__tag {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--logo-tag);
  }

  /* Impilato: marchio sopra, testo centrato sotto */
  .logo--stacked {
    flex-direction: column;
    text-align: center;
  }
  .logo--stacked .logo__text {
    align-items: center;
  }

  .logo--emblem-only {
    gap: 0;
  }

  @media (max-width: 420px) {
    .logo__name {
      font-size: 1.3rem;
    }
    .logo__tag {
      font-size: 0.52rem;
      letter-spacing: 0.14em;
    }
  }
</style>
