---
/**
 * Logo Desideri di Felicità — marchio "ricciolo" (DF monolinea) + wordmark.
 * Marchio SVG inline (tema chiaro/scuro via CSS) + nome (Quicksand) + sottotitolo.
 *
 * Props:
 *  - variant: 'horizontal' (default) | 'stacked'
 *  - theme:   'light' (default, su fondo chiaro) | 'dark' (su fondo scuro)
 *  - tagline: mostra "Jessica Asaro · Hair Stylist" (default true)
 *  - emblemOnly: solo il marchio, senza testo (avatar/icona)
 */
interface Props {
  variant?: 'horizontal' | 'stacked';
  theme?: 'light' | 'dark';
  tagline?: boolean;
  emblemOnly?: boolean;
  class?: string;
}
const {
  variant = 'horizontal',
  theme = 'light',
  tagline = true,
  emblemOnly = false,
  class: className = '',
} = Astro.props;
---

<span
  class:list={[
    'logo',
    `logo--${variant}`,
    `logo--${theme}`,
    emblemOnly && 'logo--emblem-only',
    className,
  ]}
>
  <svg class="logo__mark" viewBox="46 34 132 176" aria-hidden="true" focusable="false">
    <g fill="none" stroke-width="14" stroke-linecap="round" stroke-linejoin="round">
      <path class="logo__ink" d="M138 48 L72 48 C66 48 64 52 64 58 L64 150" />
      <path class="logo__ink" d="M64 101 L112 101" />
      <path
        class="logo__accent"
        d="M64 150 C64 182 98 194 126 176 C156 158 160 110 122 94 C102 86 88 102 100 118 C107 127 120 122 117 112"
      />
    </g>
  </svg>

  {
    !emblemOnly && (
      <span class="logo__text">
        <span class="logo__name">Desideri di felicità</span>
        {tagline && <span class="logo__tag">Jessica Asaro · Hair Stylist</span>}
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    text-decoration: none;
    line-height: 1;
    /* colori del marchio per tema */
    --logo-ink: var(--color-primary-strong, #34425c);
    --logo-accent: var(--color-gold, #c2a268);
    --logo-name: var(--color-primary-strong, #34425c);
    --logo-tag: var(--color-gold-strong, #a6864a);
  }
  .logo--dark {
    --logo-ink: var(--color-on-dark, #eef1f5);
    --logo-accent: var(--color-gold-on-dark, #d4b277);
    --logo-name: var(--color-on-dark, #eef1f5);
    --logo-tag: var(--color-gold-on-dark, #d4b277);
  }

  .logo__mark {
    width: auto;
    height: 2.6em;
    flex: none;
    overflow: visible;
  }
  .logo__ink {
    stroke: var(--logo-ink);
  }
  .logo__accent {
    stroke: var(--logo-accent);
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
  }
  .logo__name {
    font-family: 'Quicksand', var(--font-body);
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: -0.005em;
    color: var(--logo-name);
  }
  .logo__tag {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--logo-tag);
  }

  /* Impilato: marchio sopra, testo centrato sotto */
  .logo--stacked {
    flex-direction: column;
    gap: 0.4em;
    text-align: center;
  }
  .logo--stacked .logo__mark {
    height: 3.4em;
  }
  .logo--stacked .logo__text {
    align-items: center;
  }

  .logo--emblem-only {
    gap: 0;
  }

  @media (max-width: 420px) {
    .logo__name {
      font-size: 1.12rem;
    }
  }
</style>
