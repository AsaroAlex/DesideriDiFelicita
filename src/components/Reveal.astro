---
/**
 * Wrapper per rivelazione leggera allo scroll. Aggiunge `data-reveal`:
 * lo script in BaseLayout aggiunge `.is-visible` quando l'elemento entra in
 * viewport (e rispetta prefers-reduced-motion). Usare con parsimonia.
 */
interface Props {
  as?: keyof HTMLElementTagNameMap;
  class?: string;
}
const { as = 'div', class: className } = Astro.props;
const Tag = as as any;
---

<Tag data-reveal class={className}>
  <slot />
</Tag>
