---
interface Props {
  name: string;
  description: string;
  index?: number;
  price?: string;
  /** Se true mostra il prezzo; altrimenti "su richiesta" (prezzi non confermati) */
  priceConfirmed?: boolean;
}
const { name, description, index, price, priceConfirmed = false } = Astro.props;
const num = typeof index === 'number' ? String(index).padStart(2, '0') : null;
---

<article class="card service">
  {num && <span class="index-num service__num">{num}</span>}
  <h3 class="service__name">{name}</h3>
  <p class="service__desc">{description}</p>
  <p class="service__price">
    {priceConfirmed && price ? price : 'Prezzo su richiesta'}
  </p>
</article>

<style>
  .service {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .service__num {
    display: block;
    margin-bottom: var(--space-xs);
  }
  .service__name {
    font-size: var(--fs-400);
  }
  .service__desc {
    margin-top: var(--space-sm);
    color: var(--color-ink-soft);
    flex: 1;
  }
  .service__price {
    margin-top: var(--space-md);
    font-weight: 600;
    color: var(--color-primary-strong);
    font-size: var(--fs-100);
    letter-spacing: 0.02em;
  }
</style>
