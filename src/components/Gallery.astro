---
import { Image } from 'astro:assets';
import type { GalleryImage } from '../data/images';

interface Props {
  images?: GalleryImage[];
  /** Numero di tessere placeholder se non ci sono ancora foto */
  placeholders?: number;
}
const { images = [], placeholders = 6 } = Astro.props;
const hasImages = images.length > 0;
---

{
  hasImages ? (
    <ul class="gallery" role="list">
      {images.map((img) => (
        <li class="gallery__item">
          <figure class="gallery__figure">
            <div class="gallery__frame">
              <Image
                src={img.src}
                alt={img.alt}
                class="gallery__img"
                widths={[320, 640, 960]}
                sizes="(min-width: 900px) 30vw, (min-width: 600px) 45vw, 90vw"
                loading="lazy"
              />
            </div>
            {(img.treatment || img.category) && (
              <figcaption class="gallery__caption">
                {img.treatment && <span class="gallery__treatment">{img.treatment}</span>}
                {img.category && <span class="gallery__category">{img.category}</span>}
              </figcaption>
            )}
          </figure>
        </li>
      ))}
    </ul>
  ) : (
    <div class="gallery-empty">
      <ul class="gallery" role="list" aria-hidden="true">
        {Array.from({ length: placeholders }).map(() => (
          <li class="gallery__item gallery__item--empty" />
        ))}
      </ul>
      <p class="note gallery-empty__note">
        Le foto dei lavori saranno disponibili a breve.
      </p>
    </div>
  )
}

<style>
  .gallery {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    margin: 0;
  }
  .gallery__item {
    min-width: 0;
  }
  .gallery__figure {
    display: grid;
    gap: var(--space-sm);
  }
  .gallery__frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    aspect-ratio: 3 / 4;
    background: var(--color-surface-alt);
  }
  .gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }
  .gallery__frame:hover .gallery__img {
    transform: scale(1.04);
  }
  .gallery__caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-inline: 0.15rem;
  }
  .gallery__treatment {
    font-family: var(--font-display);
    font-size: var(--fs-300);
    line-height: 1.2;
    color: var(--color-ink);
  }
  .gallery__category {
    flex: none;
    color: var(--color-gold-strong);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .gallery__item--empty {
    background:
      linear-gradient(135deg, var(--color-blush) 0%, var(--color-surface-alt) 100%);
    border: 1px dashed var(--color-line);
  }
  .gallery-empty__note {
    margin-top: var(--space-md);
    text-align: center;
  }
</style>
