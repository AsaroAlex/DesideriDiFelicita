---
import { site } from '../data/site';
import { withBase } from '../lib/href';
import { telHref } from '../lib/contact';

const year = new Date().getFullYear();
const c = site.confirmed;
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <p class="footer__name">Desideri di Felicità</p>
      <p class="footer__motto">{site.slogan}</p>
      <p class="footer__note">di {site.ownerName} · {site.role}</p>
    </div>

    <div>
      <h2 class="footer__title">Dove siamo</h2>
      <address class="footer__address">
        {site.address.street}<br />
        {site.address.postalCode} {site.address.city} ({site.address.province})
      </address>
    </div>

    <div>
      <h2 class="footer__title">Contatti</h2>
      <ul class="footer__list" role="list">
        <li><a href={telHref(site.phone)}>{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.instagramUrl} target="_blank" rel="noopener">Instagram</a></li>
      </ul>
    </div>

    <div>
      <h2 class="footer__title">Orari</h2>
      <ul class="footer__list" role="list">
        {
          site.openingHours.map((o) => (
            <li>
              {o.label}:{' '}
              {o.ranges.length
                ? o.ranges.map((r) => `${r.opens}–${r.closes}`).join(' · ')
                : 'Chiuso'}
            </li>
          ))
        }
      </ul>
      {!c.openingHours && <span class="badge-tbc">da confermare</span>}
    </div>
  </div>

  <div class="container footer__bottom">
    <p class="footer__note">
      © {year} {site.businessName}.{' '}
      {site.legal.vatNumber && <>P.IVA {site.legal.vatNumber}. </>}
      Galliera (BO).
    </p>
    <p class="footer__note">
      <a href={withBase('/')}>Home</a> · <a href={withBase('/contatti')}>Contatti</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    background: linear-gradient(170deg, var(--color-dark) 0%, var(--color-dark-2) 100%);
    color: var(--color-on-dark);
    padding-block: var(--space-2xl) var(--space-lg);
  }
  .footer :global(a) {
    color: var(--color-on-dark);
    text-decoration: none;
  }
  .footer :global(a:hover) {
    color: var(--color-gold-on-dark);
  }
  .footer__grid {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 720px) {
    .footer__grid {
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
    }
  }
  .footer__name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--color-on-dark);
  }
  .footer__motto {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-gold-on-dark);
    margin-top: var(--space-2xs);
    max-width: 28ch;
  }
  .footer__title {
    font-family: var(--font-body);
    font-size: 0.74rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-gold-on-dark);
    margin-bottom: var(--space-sm);
  }
  .footer__address {
    font-style: normal;
    line-height: var(--lh-normal);
    color: var(--color-on-dark-soft);
  }
  .footer__list {
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }
  .footer__note {
    font-size: var(--fs-100);
    color: var(--color-on-dark-soft);
    margin-top: var(--space-2xs);
  }
  .footer :global(.badge-tbc) {
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-gold-on-dark);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
</style>
