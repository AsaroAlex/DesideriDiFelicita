---
import { withBase } from '../lib/href';
import Logo from './Logo.astro';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/servizi', label: 'Servizi' },
  { href: '/galleria', label: 'Galleria' },
  { href: '/chi-siamo', label: 'Chi siamo' },
  { href: '/contatti', label: 'Contatti' },
];

const norm = (p: string) => '/' + p.replace(/^\/+|\/+$/g, '');
const current = norm(Astro.url.pathname);
const isActive = (href: string) => norm(withBase(href)) === current;
---

<header class="header">
  <div class="container header__inner">
    <a class="brand" href={withBase('/')}>
      <Logo variant="horizontal" />
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Apri il menu"
    >
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Navigazione principale">
      <ul class="nav__list" role="list">
        {
          nav.map((item) => (
            <li>
              <a
                class="nav__link"
                href={withBase(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn nav__cta" href={withBase('/prenota')} aria-current={isActive('/prenota') ? 'page' : undefined}>Prenota</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 800;
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    backdrop-filter: saturate(150%) blur(10px);
    border-bottom: 1px solid transparent;
    transition: background-color var(--transition), border-color var(--transition),
      box-shadow var(--transition);
  }
  .header.is-scrolled {
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    border-bottom-color: var(--color-line);
    box-shadow: 0 6px 24px rgba(11, 18, 32, 0.07);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .brand:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 4px;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }
  .nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    margin: 0;
  }
  .nav__link {
    position: relative;
    text-decoration: none;
    color: var(--color-ink-soft);
    font-weight: 500;
    font-size: 0.98rem;
    padding: 0.3rem 0;
    transition: color var(--transition);
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1.5px;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--transition);
  }
  .nav__link:hover {
    color: var(--color-ink);
  }
  .nav__link:hover::after,
  .nav__link[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .nav__link[aria-current='page'] {
    color: var(--color-ink);
  }
  .nav :global(.nav__cta) {
    --btn-bg: transparent;
    --btn-fg: var(--color-primary-strong);
    border-color: color-mix(in srgb, var(--color-primary) 24%, transparent);
    padding: 0.55em 1.2em;
    font-size: 0.92rem;
  }
  .nav :global(.nav__cta:hover) {
    --btn-bg: var(--color-primary);
    --btn-fg: #fff;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    width: 2.85rem;
    height: 2.85rem;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .nav-toggle__bar {
    width: 22px;
    height: 2px;
    background: var(--color-ink);
    transition: transform var(--transition), opacity var(--transition);
  }
  .nav-toggle:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 4px;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 880px) {
    .header:not([data-nav-ready]) {
      position: relative;
    }
    .header__inner {
      flex-wrap: wrap;
      padding-block: var(--space-sm);
    }
    .header[data-nav-ready] .header__inner {
      flex-wrap: nowrap;
      padding-block: 0;
    }
    .header[data-nav-ready] .nav-toggle {
      display: flex;
    }
    .nav {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-md);
      padding-block: var(--space-sm) var(--space-lg);
    }
    .header[data-nav-ready] .nav {
      position: absolute;
      inset: 100% 0 auto 0;
      width: auto;
      max-height: var(--nav-max-height, calc(100dvh - var(--header-h)));
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: var(--space-lg) var(--gutter) var(--space-xl);
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-line);
      box-shadow: var(--shadow-md);
      transform: translateY(-12px);
      opacity: 0;
      visibility: hidden;
      transition: opacity var(--transition), transform var(--transition),
        visibility var(--transition);
    }
    .header[data-nav-ready] .nav.is-open {
      transform: none;
      opacity: 1;
      visibility: visible;
    }
    .nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-sm);
    }
    .nav__link {
      display: block;
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--color-line);
    }
    .nav :global(.nav__cta) {
      justify-content: center;
      width: 100%;
    }
  }
</style>

<script>
  const initializedHeaders = new WeakSet<HTMLElement>();
  let observedHeader: HTMLElement | null = null;
  const headerObserver = new ResizeObserver(updateNavSize);

  function closeNav(returnFocus = false) {
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const nav = document.getElementById('site-nav');
    if (toggle && nav?.classList.contains('is-open')) {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Apri il menu');
      nav.classList.remove('is-open');
      if (returnFocus) toggle.focus();
    }
  }

  function updateNavSize() {
    const header = document.querySelector<HTMLElement>('.header');
    if (!header) return;
    const viewportHeight = window.visualViewport?.height ?? window.innerHeight;
    const availableHeight = Math.max(0, viewportHeight - header.getBoundingClientRect().bottom);
    header.style.setProperty('--nav-max-height', `${availableHeight}px`);
    if (!window.matchMedia('(max-width: 880px)').matches) closeNav();
  }

  function initNav() {
    const header = document.querySelector<HTMLElement>('.header');
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const nav = document.getElementById('site-nav');
    if (!header || !toggle || !nav || initializedHeaders.has(header)) return;
    initializedHeaders.add(header);

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      updateNavSize();
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Chiudi il menu' : 'Apri il menu');
      nav.classList.toggle('is-open', open);
    });

    nav.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', () => closeNav())
    );

    header.addEventListener('focusout', () => {
      queueMicrotask(() => {
        const focus = document.activeElement;
        if (focus !== toggle && !nav.contains(focus)) closeNav();
      });
    });

    header.dataset.navReady = 'true';
    if (observedHeader) headerObserver.unobserve(observedHeader);
    observedHeader = header;
    headerObserver.observe(header);
    updateNavSize();
  }

  function onScroll() {
    const header = document.querySelector('.header');
    if (header) header.classList.toggle('is-scrolled', window.scrollY > 8);
  }

  function initHeader() {
    initNav();
    onScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader, { once: true });
  } else {
    initHeader();
  }
  document.addEventListener('astro:page-load', initHeader);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeNav(true);
  });
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', updateNavSize, { passive: true });
  window.visualViewport?.addEventListener('resize', updateNavSize, { passive: true });
</script>
