# Configurazione locale (copiare in .env). Node 24: npm ci, npm run build, npm start.
# Su Railway le stesse variabili si impostano in Variables; .env non serve.
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATA_DIR=.data

# Chiave server (32 byte in base64): cifra il collegamento WhatsApp e firma i link
# personali delle clienti. Generarla una volta e conservarla in privato:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
WHATSAPP_CONFIG_KEY=

# Link privato per l'area di Jessica (prima attivazione o password dimenticata).
# Generare token e scadenza con: npm run link-accesso
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_BOOTSTRAP_EXPIRES_AT=

# Facoltativi: in alternativa si configurano dal portale (WhatsApp automatico).
# Servono un template Utility approvato con tre parametri: nome, data, ora.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=it
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
