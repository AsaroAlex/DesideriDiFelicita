# Configurazione locale dell'agenda. Node 24, npm run build, npm start.
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATA_DIR=.data

# Generare il token con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Impostare una scadenza ISO futura. Il collegamento funziona solo per il primo accesso.
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_BOOTSTRAP_EXPIRES_AT=

# Facoltativi fino all'attivazione della WhatsApp Business Platform.
# Un template Utility approvato con parametri posizionali: nome, data, ora.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=it
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
